.detail-page {
  display: flex;
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-5) var(--space-4) calc(var(--space-8) + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  flex-direction: column;
  gap: var(--space-4);
}

.detail-state {
  display: flex;
  min-height: 480rpx;
  padding: var(--space-5);
  align-items: center;
  justify-content: center;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
  flex-direction: column;
  gap: var(--space-3);
  text-align: center;
}

.detail-state--error {
  border-color: var(--color-error-border);
  background: var(--color-error-bg);
}

.state-title,
.section-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
}

.state-description,
.order-time,
.detail-label,
.item-meta,
.history-remark,
.history-time,
.history-empty {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.state-action {
  width: 100%;
  min-height: var(--size-touch-min);
}

.summary-card,
.action-card,
.detail-card {
  padding: var(--space-4);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  box-shadow: var(--shadow-card);
}

.summary-top,
.summary-money-row,
.payment-row,
.detail-row,
.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.order-no,
.order-time,
.section-title,
.detail-label,
.item-name,
.item-meta,
.history-status,
.history-remark,
.history-time {
  display: block;
}

.order-no,
.item-name,
.history-status {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.summary-money-row {
  margin-top: var(--space-5);
}

.summary-label {
  color: var(--color-text-secondary);
}

.summary-money {
  color: var(--color-price);
  font-size: var(--type-money-size);
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
}

.payment-row {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: var(--border-width-default) solid var(--color-divider);
  color: var(--color-text-secondary);
}

.status-badge {
  padding: var(--space-1) var(--space-2);
  border: var(--border-width-default) solid var(--status-pending-border);
  border-radius: var(--radius-round);
  background: var(--status-pending-bg);
  color: var(--status-pending-text);
  font-size: var(--type-caption-size);
  white-space: nowrap;
}

.status-badge--PREPARING {
  border-color: var(--status-preparing-border);
  background: var(--status-preparing-bg);
  color: var(--status-preparing-text);
}

.status-badge--READY_FOR_PICKUP {
  border-color: var(--status-ready-border);
  background: var(--status-ready-bg);
  color: var(--status-ready-text);
}

.status-badge--COMPLETED {
  border-color: var(--status-completed-border);
  background: var(--status-completed-bg);
  color: var(--status-completed-text);
}

.status-badge--CANCELLED {
  border-color: var(--status-cancelled-border);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.detail-action {
  min-height: var(--size-touch-min);
}

.detail-action--danger {
  padding-top: var(--space-3);
  border-top: var(--border-width-default) solid var(--color-divider);
}

.section-title {
  margin-bottom: var(--space-3);
}

.detail-row,
.item-row {
  min-height: var(--size-touch-min);
  border-bottom: var(--border-width-default) solid var(--color-divider);
}

.detail-row:last-child,
.item-row:last-child {
  border-bottom: 0;
}

.detail-note,
.cancel-reason {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  color: var(--color-text-primary);
}

.cancel-reason {
  border: var(--border-width-default) solid var(--color-error-border);
  background: var(--color-error-bg);
  color: var(--color-error-text);
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-subtotal {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
}

.history-row {
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.history-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border: 4rpx solid var(--primary-300);
  border-radius: var(--radius-round);
  background: var(--primary-600);
}

.inline-retry {
  display: inline-flex;
  min-height: var(--size-touch-min);
  margin-left: var(--space-2);
  align-items: center;
  color: var(--primary-600);
  font-weight: var(--weight-semibold);
}
