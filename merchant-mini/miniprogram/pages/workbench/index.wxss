.workbench-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.state-card {
  display: flex;
  min-height: 280rpx;
  padding: var(--space-5);
  align-items: center;
  justify-content: center;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
  flex-direction: column;
  gap: var(--space-3);
  text-align: center;
}

.state-card--compact {
  min-height: 200rpx;
}

.state-card--error {
  border-color: var(--color-error-border);
  background: var(--color-error-bg);
}

.state-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
}

.state-description,
.section-description,
.order-time {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.state-action {
  min-width: 240rpx;
  min-height: var(--size-touch-min);
}

.section-title {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-section-title-line);
}

.section-description,
.order-no,
.order-time {
  display: block;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
}

.metric-card {
  display: flex;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: var(--space-3);
  justify-content: center;
  border: var(--border-width-default) solid var(--color-border-default);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  flex-direction: column;
  text-align: center;
  transition: background-color var(--duration-fast) var(--easing-standard);
}

.metric-card--pressed,
.order-card--pressed {
  background: var(--color-bg-hover);
}

.metric-label {
  color: var(--color-text-secondary);
  font-size: var(--type-label-size);
}

.metric-value {
  color: var(--primary-600);
  font-size: 56rpx;
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
  line-height: 72rpx;
}

.metric-unit {
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
}

.attention-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.attention-card {
  display: flex;
  padding: var(--space-4);
  align-items: baseline;
  justify-content: space-between;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
}

.attention-value {
  color: var(--color-text-primary);
  font-size: var(--type-data-size);
  font-weight: var(--weight-bold);
}

.attention-label {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.section-heading--orders {
  margin-top: var(--space-2);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.order-card {
  box-sizing: border-box;
  min-height: var(--size-touch-min);
  padding: var(--space-4);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  box-shadow: var(--shadow-card);
}

.order-card__top,
.order-card__bottom,
.order-money-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.order-card__bottom {
  margin-top: var(--space-4);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.order-no {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.status-badge,
.payment-label {
  padding: var(--space-1) var(--space-2);
  border: var(--border-width-default) solid var(--status-pending-border);
  border-radius: var(--radius-round);
  background: var(--status-pending-bg);
  color: var(--status-pending-text);
  font-size: var(--type-caption-size);
  white-space: nowrap;
}

.status-badge--PREPARING {
  border-color: var(--status-preparing-border);
  background: var(--status-preparing-bg);
  color: var(--status-preparing-text);
}

.status-badge--READY_FOR_PICKUP {
  border-color: var(--status-ready-border);
  background: var(--status-ready-bg);
  color: var(--status-ready-text);
}

.status-badge--COMPLETED {
  border-color: var(--status-completed-border);
  background: var(--status-completed-bg);
  color: var(--status-completed-text);
}

.status-badge--CANCELLED {
  border-color: var(--status-cancelled-border);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.payment-label {
  border-color: var(--payment-unpaid-border);
  background: var(--payment-unpaid-bg);
  color: var(--payment-unpaid-text);
}

.order-money {
  color: var(--color-price);
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
}

.inline-retry {
  display: inline-flex;
  min-height: var(--size-touch-min);
  margin-left: var(--space-2);
  align-items: center;
  color: var(--primary-600);
  font-weight: var(--weight-semibold);
}
