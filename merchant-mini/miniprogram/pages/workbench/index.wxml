<view class="page-shell workbench-page">
  <view class="card employee-card" wx:if="{{session}}">
    <employee-header username="{{session.username}}" role="{{session.role}}" />
  </view>

  <view wx:if="{{isLoading && !summary}}" class="state-card" role="status" aria-live="polite">
    <t-loading theme="circular" size="48rpx" />
    <text>正在加载工作台…</text>
  </view>

  <view wx:elif="{{errorMessage && !summary}}" class="state-card state-card--error" role="alert">
    <text class="state-title">工作台暂时无法加载</text>
    <text class="state-description">{{errorMessage}}</text>
    <view class="state-action">
      <t-button block disabled="{{isLoading}}" loading="{{isLoading}}" bindtap="retry">重新加载</t-button>
    </view>
  </view>

  <block wx:else>
    <view class="section-heading">
      <text class="section-title">今日订单处理</text>
      <text class="section-description">优先处理待接单，再跟进备货和取货</text>
    </view>

    <view class="metric-grid">
      <view
        wx:for="{{metrics}}"
        wx:key="status"
        class="metric-card metric-card--{{item.status}}"
        role="button"
        aria-label="{{item.label}} {{item.count}} 单"
        data-status="{{item.status}}"
        bindtap="onMetricTap"
        hover-class="metric-card--pressed"
      >
        <text class="metric-label">{{item.label}}</text>
        <text class="metric-value">{{item.count}}</text>
        <text class="metric-unit">单</text>
      </view>
    </view>

    <view class="attention-grid" wx:if="{{summary}}">
      <view class="attention-card">
        <text class="attention-value">{{summary.lowStockCount}}</text>
        <text class="attention-label">低库存商品</text>
      </view>
      <view class="attention-card">
        <text class="attention-value">{{summary.waitingConversationCount}}</text>
        <text class="attention-label">待回复会话</text>
      </view>
    </view>

    <view class="section-heading section-heading--orders">
      <text class="section-title">最近订单</text>
      <text class="section-description">点击订单查看处理详情</text>
    </view>

    <view wx:if="{{latestOrders.length === 0}}" class="state-card state-card--compact">
      <text class="state-title">暂时没有最近订单</text>
      <text class="state-description">新订单到店后会显示在这里</text>
    </view>

    <view wx:else class="order-list">
      <view
        wx:for="{{latestOrders}}"
        wx:key="orderNo"
        class="order-card"
        role="button"
        aria-label="订单 {{item.orderNo}}，{{item.statusLabel}}"
        data-order-no="{{item.orderNo}}"
        bindtap="onOrderTap"
        hover-class="order-card--pressed"
      >
        <view class="order-card__top">
          <view>
            <text class="order-no">{{item.orderNo}}</text>
            <text class="order-time">{{item.createdAtText}}</text>
          </view>
          <text class="status-badge status-badge--{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <view class="order-card__bottom">
          <text>{{item.pickupName}} · {{item.maskedPhone}}</text>
          <view class="order-money-group">
            <text class="payment-label">{{item.paymentLabel}}</text>
            <text class="order-money">{{item.amountText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{errorMessage && summary}}" class="feedback-error" role="alert">
    <text>{{errorMessage}}</text>
    <text class="inline-retry" role="button" bindtap="retry">重新加载</text>
  </view>
</view>

<app-tab-bar value="workbench" />
