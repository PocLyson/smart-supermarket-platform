<view class="workbench-page">
  <view class="workbench-header" wx:if="{{session}}">
    <view class="workbench-header__identity">
      <image class="workbench-header__home" src="/assets/icons/workbench.svg" mode="aspectFit" aria-hidden="true" />
      <view>
        <text class="workbench-header__title">工作台</text>
        <text class="workbench-header__store">鲁能超市李老家分店</text>
      </view>
    </view>
    <view class="employee-pill" role="button" aria-label="进入我的，当前账号 {{session.username}} {{roleLabel}}" bindtap="onProfileTap" hover-class="employee-pill--pressed">
      <image class="employee-pill__icon" src="/assets/icons/profile.svg" mode="aspectFit" aria-hidden="true" />
      <text>{{session.username}} {{roleLabel}}</text>
    </view>
  </view>

  <view class="workbench-content">
    <view wx:if="{{isLoading && !summary}}" class="state-card" role="status" aria-live="polite">
      <t-loading theme="circular" size="48rpx" />
      <text>正在加载工作台…</text>
    </view>

    <view wx:elif="{{errorMessage && !summary}}" class="state-card state-card--error" role="alert">
      <text class="state-title">工作台暂时无法加载</text>
      <text class="state-description">{{errorMessage}}</text>
      <view class="state-action">
        <t-button block disabled="{{isLoading}}" loading="{{isLoading}}" bindtap="retry">重新加载</t-button>
      </view>
    </view>

    <block wx:else>
      <view class="section-heading">
        <text class="section-title">优先处理</text>
      </view>

      <view class="priority-card">
        <view
          wx:for="{{metrics}}"
          wx:key="status"
          class="priority-row priority-row--{{item.tone}}"
          role="button"
          aria-label="{{item.label}} {{item.count}} 笔"
          data-status="{{item.status}}"
          bindtap="onMetricTap"
          hover-class="priority-row--pressed"
        >
          <view class="priority-row__icon priority-row__icon--{{item.tone}}">
            <image class="priority-icon-image priority-icon-image--{{item.tone}}" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
          </view>
          <text class="priority-row__label">{{item.label}}</text>
          <text class="priority-row__count priority-row__count--{{item.tone}}">{{item.count}}笔</text>
          <view wx:if="{{index === 0 && item.count > 0}}" class="priority-row__button">
            <text>立即处理</text><text class="priority-row__button-arrow">›</text>
          </view>
          <text wx:else class="priority-row__arrow">›</text>
        </view>
      </view>

      <view class="shortcut-card" aria-label="常用功能">
        <view class="shortcut-item" role="button" data-shortcut="verification" bindtap="onShortcutTap" hover-class="shortcut-item--pressed">
          <image class="shortcut-icon" src="/assets/icons/verification.svg" mode="aspectFit" aria-hidden="true" />
          <text>扫码核销</text>
        </view>
        <view class="shortcut-item" role="button" data-shortcut="products" bindtap="onShortcutTap" hover-class="shortcut-item--pressed">
          <image class="shortcut-icon" src="/assets/icons/workbench.svg" mode="aspectFit" aria-hidden="true" />
          <text>商品管理</text>
        </view>
        <view class="shortcut-item" role="button" data-shortcut="announcements" bindtap="onShortcutTap" hover-class="shortcut-item--pressed">
          <image class="shortcut-icon" src="/assets/icons/messages.svg" mode="aspectFit" aria-hidden="true" />
          <text>发布公告</text>
        </view>
      </view>

      <view class="section-heading section-heading--overview">
        <text class="section-title">今日概览</text>
      </view>

      <view class="overview-card" wx:if="{{summary}}">
        <view class="overview-item">
          <text class="overview-label">已完成</text>
          <text class="overview-value overview-value--completed">{{completedCount}}</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">低库存</text>
          <text class="overview-value overview-value--warning">{{summary.lowStockCount}}</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">待回复</text>
          <text class="overview-value overview-value--danger">{{summary.waitingConversationCount}}</text>
        </view>
      </view>

      <view class="section-heading section-heading--orders">
        <text class="section-title">最近订单</text>
        <view class="section-link" role="button" bindtap="onAllOrdersTap" hover-class="section-link--pressed">
          <text>全部订单</text><text>›</text>
        </view>
      </view>

      <view wx:if="{{latestOrders.length === 0}}" class="state-card state-card--compact">
        <text class="state-title">暂时没有最近订单</text>
        <text class="state-description">新订单到店后会显示在这里</text>
      </view>

      <view wx:else class="order-list">
        <view
          wx:for="{{latestOrders}}"
          wx:key="orderNo"
          class="order-row"
          role="button"
          aria-label="订单 {{item.orderNo}}，{{item.statusLabel}}"
          data-order-no="{{item.orderNo}}"
          bindtap="onOrderTap"
          hover-class="order-row--pressed"
        >
          <view class="order-row__main">
            <text class="order-recipient">收件人：{{item.pickupName}}</text>
            <text class="order-customer">电话：{{item.maskedPhone}}</text>
            <text class="order-time">{{item.createdAtText}}</text>
          </view>
          <view class="order-row__aside">
            <text class="order-status order-status--{{item.status}}">{{item.statusLabel}}</text>
            <text class="order-money">{{item.amountText}}</text>
          </view>
          <image class="order-row__arrow-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
    </block>

    <view wx:if="{{errorMessage && summary}}" class="feedback-error" role="alert">
      <text>{{errorMessage}}</text>
      <text class="inline-retry" role="button" bindtap="retry">重新加载</text>
    </view>
  </view>

  <app-tab-bar value="workbench" />
</view>
