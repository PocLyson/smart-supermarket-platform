<view class="merchant-page-header">
  <text class="merchant-page-header__eyebrow">员工中心</text>
  <text class="merchant-page-header__title">我的</text>
  <text class="merchant-page-header__description">管理员工账号与常用功能</text>
</view>

<view class="page-shell profile-page" wx:if="{{session}}">
  <view class="profile-identity-card">
    <text class="profile-identity-card__label">员工账号</text>
    <employee-header username="{{session.username}}" role="{{session.role}}" />
  </view>

  <view class="section profile-section">
    <text class="section-title">账号功能</text>
    <view class="shortcut-list">
      <view
        wx:for="{{shortcuts}}"
        wx:key="id"
        class="shortcut-item"
        role="button"
        aria-label="{{item.label}}"
        data-id="{{item.id}}"
        bindtap="onShortcutTap"
        hover-class="shortcut-item--pressed"
      >
        <text>{{item.label}}</text>
        <view class="shortcut-chevron" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <view class="section binding-card">
    <text class="binding-title">当前微信绑定</text>
    <text class="binding-description">解绑后将退出商家端，下次登录需要使用员工账号和密码重新绑定当前微信。</text>
    <view class="binding-action">
      <t-button
        theme="danger"
        variant="outline"
        block
        loading="{{isUnbinding}}"
        disabled="{{isLoading || isUnbinding}}"
        bindtap="confirmUnbind"
      >{{isUnbinding ? '解绑中…' : '解绑当前微信'}}</t-button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="feedback-error" role="alert" aria-live="polite">
    <text>{{errorMessage}}</text>
  </view>

  <view class="logout-action">
    <t-button
      theme="danger"
      variant="outline"
      block
      loading="{{isLoading}}"
      disabled="{{isLoading || isUnbinding}}"
      bindtap="logout"
    >退出登录</t-button>
  </view>
</view>

<app-tab-bar value="profile" />
