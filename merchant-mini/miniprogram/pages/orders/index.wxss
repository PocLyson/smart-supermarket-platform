.merchant-page-header {
  display: flex;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: calc(104rpx + env(safe-area-inset-top)) 32rpx 34rpx;
  align-items: flex-end;
  justify-content: space-between;
  background: var(--primary-600);
  color: var(--color-bg-surface);
}

.merchant-page-header__title,
.summary-metric__label,
.summary-metric__value,
.order-no,
.order-time,
.customer-name,
.customer-phone {
  display: block;
}

.merchant-page-header__title {
  font-size: 46rpx;
  font-weight: var(--weight-bold);
  line-height: 1.15;
}

.header-refresh {
  display: flex;
  width: var(--size-touch-min);
  height: var(--size-touch-min);
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: var(--radius-round);
  color: var(--color-bg-surface);
}

.header-refresh--pressed {
  background: rgba(255, 255, 255, 0.14);
}

.header-refresh.is-disabled,
.search-action.is-disabled {
  opacity: 0.45;
}

.local-icon {
  display: block;
  flex: none;
}

.local-icon--refresh {
  width: 44rpx;
  height: 44rpx;
}

.local-icon--search {
  width: 40rpx;
  height: 40rpx;
}

.local-icon--filter,
.local-icon--chevron {
  width: 42rpx;
  height: 42rpx;
}

.local-icon--marker {
  width: 24rpx;
  height: 24rpx;
}

.order-summary-strip {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: -24rpx 16rpx 0;
  padding: 28rpx 24rpx 30rpx;
  border-radius: 32rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 12rpx 32rpx rgba(13, 27, 54, 0.08);
}

.summary-metric {
  position: relative;
  display: flex;
  min-height: var(--size-touch-min);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
}

.summary-metric + .summary-metric::before {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  width: 2rpx;
  background: var(--color-divider);
  content: '';
}

.summary-metric__label {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.summary-metric__value {
  color: var(--primary-600);
  font-size: 44rpx;
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.orders-page {
  display: flex;
  padding-top: var(--space-4);
  flex-direction: column;
  gap: var(--space-3);
}

.search-toolbar {
  display: flex;
  align-items: stretch;
  gap: var(--space-2);
}

.search-control {
  display: flex;
  min-width: 0;
  min-height: var(--size-touch-min);
  padding: 0 var(--space-3);
  align-items: center;
  border: var(--border-width-default) solid var(--color-border-control);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  flex: 1;
  gap: var(--space-2);
}

.search-control:focus-within {
  border-color: var(--border-color-focus);
  box-shadow: var(--shadow-focus);
}

.search-input {
  min-width: 0;
  height: var(--size-touch-min);
  color: var(--color-text-primary);
  flex: 1;
  font-size: var(--type-helper-size);
}

.search-action,
.filter-trigger {
  display: flex;
  box-sizing: border-box;
  min-width: var(--size-touch-min);
  min-height: var(--size-touch-min);
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
}

.search-action {
  padding: 0 var(--space-3);
  background: var(--primary-600);
  color: var(--color-bg-surface);
  font-weight: var(--weight-semibold);
}

.filter-trigger {
  border: var(--border-width-default) solid var(--primary-600);
  background: var(--primary-600);
  color: var(--color-bg-surface);
}

.filter-trigger.is-active {
  border-color: var(--primary-700);
  background: var(--primary-700);
}

.control--pressed,
.order-card--pressed {
  opacity: 0.78;
}

.status-tabs {
  width: 100%;
  white-space: nowrap;
}

.status-tabs__inner {
  display: inline-flex;
  padding: 2rpx;
  gap: var(--space-2);
}

.status-tab {
  display: inline-flex;
  box-sizing: border-box;
  min-height: var(--size-touch-min);
  padding: 0 var(--space-4);
  align-items: center;
  justify-content: center;
  border: var(--border-width-default) solid var(--color-border-control);
  border-radius: var(--radius-round);
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
}

.status-tab.is-active {
  border-color: var(--primary-600);
  background: var(--primary-600);
  color: var(--color-bg-surface);
  font-weight: var(--weight-semibold);
  box-shadow: 0 8rpx 20rpx rgba(8, 47, 107, 0.18);
}

.payment-filter-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: var(--space-2);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  gap: var(--space-2);
}

.payment-tab {
  display: flex;
  min-height: var(--size-touch-min);
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.payment-tab.is-active {
  background: var(--primary-100);
  color: var(--primary-600);
  font-weight: var(--weight-semibold);
}

.list-state {
  display: flex;
  min-height: 320rpx;
  padding: var(--space-5);
  align-items: center;
  justify-content: center;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
  flex-direction: column;
  gap: var(--space-3);
  text-align: center;
}

.list-state--error {
  border-color: var(--color-error-border);
  background: var(--color-error-bg);
}

.state-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
}

.state-description,
.order-time,
.customer-phone,
.order-meta,
.list-end {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.state-action,
.load-more {
  width: 100%;
  min-height: var(--size-touch-min);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.order-timeline {
  display: flex;
  padding-left: 32rpx;
  border-left: 2rpx solid var(--color-divider);
  flex-direction: column;
  gap: var(--space-3);
}

.order-card {
  position: relative;
  display: grid;
  box-sizing: border-box;
  min-height: 228rpx;
  padding: var(--space-4);
  grid-template-columns: minmax(0, 1fr) auto;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  box-shadow: var(--shadow-card);
  column-gap: var(--space-3);
  row-gap: var(--space-3);
}

.timeline-marker {
  position: absolute;
  top: 34rpx;
  left: -44rpx;
  display: flex;
  width: 24rpx;
  height: 24rpx;
  align-items: center;
  justify-content: center;
  border: 6rpx solid var(--color-bg-page);
  border-radius: var(--radius-round);
  background: var(--color-bg-page);
}

.order-card__top,
.order-card__body {
  min-width: 0;
}

.order-title-line,
.order-customer,
.order-meta,
.order-card__amount {
  display: flex;
  align-items: center;
}

.order-title-line {
  min-width: 0;
  gap: var(--space-2);
}

.order-no {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--type-label-size);
  font-weight: var(--weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-time {
  margin-top: var(--space-1);
}

.order-card__body {
  display: flex;
  grid-column: 1 / 2;
  flex-direction: column;
  gap: var(--space-2);
}

.order-customer {
  gap: var(--space-3);
}

.customer-name {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
}

.order-meta {
  justify-content: space-between;
  gap: var(--space-2);
}

.order-card__amount {
  grid-row: 1 / 3;
  grid-column: 2;
  align-self: center;
  justify-content: flex-end;
  gap: var(--space-1);
}

.status-badge,
.payment-badge {
  padding: 4rpx 14rpx;
  border: var(--border-width-default) solid var(--status-pending-border);
  border-radius: var(--radius-round);
  background: var(--status-pending-bg);
  color: var(--status-pending-text);
  font-size: var(--type-caption-size);
  white-space: nowrap;
}

.status-badge--PREPARING {
  border-color: var(--status-preparing-border);
  background: var(--status-preparing-bg);
  color: var(--status-preparing-text);
}

.status-badge--READY_FOR_PICKUP {
  border-color: var(--status-ready-border);
  background: var(--status-ready-bg);
  color: var(--status-ready-text);
}

.status-badge--COMPLETED {
  border-color: var(--status-completed-border);
  background: var(--status-completed-bg);
  color: var(--status-completed-text);
}

.status-badge--CANCELLED {
  border-color: var(--status-cancelled-border);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.payment-badge {
  border-color: var(--payment-unpaid-border);
  background: var(--payment-unpaid-bg);
  color: var(--payment-unpaid-text);
}

.payment-badge--PAID {
  border-color: var(--payment-paid-border);
  background: var(--payment-paid-bg);
  color: var(--payment-paid-text);
}

.order-money {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
}

.inline-retry {
  display: inline-flex;
  min-height: var(--size-touch-min);
  margin-left: var(--space-2);
  align-items: center;
  color: var(--primary-600);
  font-weight: var(--weight-semibold);
}

.list-end {
  display: block;
  padding: var(--space-3);
  text-align: center;
}
