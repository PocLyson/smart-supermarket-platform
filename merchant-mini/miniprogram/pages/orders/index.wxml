<view class="merchant-page-header">
  <text class="merchant-page-header__eyebrow">门店订单</text>
  <text class="merchant-page-header__title">订单管理</text>
  <text class="merchant-page-header__description">查询订单并跟进备货、取货状态</text>
</view>

<view class="page-shell orders-page">
  <view class="order-filter-panel">
    <text class="filter-section-label">快速查询</text>
    <view class="search-card">
    <text class="search-label">搜索订单</text>
    <view class="search-row">
      <input
        class="search-input"
        value="{{draftKeyword}}"
        placeholder="输入订单号、姓名或手机号"
        confirm-type="search"
        aria-label="订单号、姓名或手机号"
        bindinput="onKeywordInput"
        bindconfirm="search"
      />
      <view
        class="search-button {{isLoading || isLoadingMore ? 'is-disabled' : ''}}"
        role="button"
        aria-disabled="{{isLoading || isLoadingMore}}"
        bindtap="search"
        hover-class="search-button--pressed"
      >查询</view>
    </view>
    </view>

    <text class="filter-section-label filter-section-label--spaced">订单状态</text>
    <scroll-view class="status-tabs" scroll-x enhanced show-scrollbar="{{false}}" aria-label="订单状态筛选">
    <view class="status-tabs__inner">
      <view
        wx:for="{{statusTabs}}"
        wx:key="value"
        class="status-tab {{selectedStatus === item.value ? 'is-active' : ''}}"
        role="button"
        aria-label="{{item.label}}"
        aria-selected="{{selectedStatus === item.value}}"
        aria-disabled="{{isLoading || isLoadingMore}}"
        data-status="{{item.value}}"
        bindtap="onStatusTap"
        hover-class="filter--pressed"
      >{{item.label}}</view>
    </view>
    </scroll-view>

    <view class="payment-tabs" aria-label="付款状态筛选">
    <view
      wx:for="{{paymentTabs}}"
      wx:key="value"
      class="payment-tab {{selectedPaymentStatus === item.value ? 'is-active' : ''}}"
      role="button"
      aria-selected="{{selectedPaymentStatus === item.value}}"
      aria-disabled="{{isLoading || isLoadingMore}}"
      data-status="{{item.value}}"
      bindtap="onPaymentTap"
      hover-class="filter--pressed"
    >{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{isLoading && orders.length === 0}}" class="list-state" role="status" aria-live="polite">
    <t-loading theme="circular" size="48rpx" />
    <text>正在加载订单…</text>
  </view>

  <view wx:elif="{{errorMessage && orders.length === 0}}" class="list-state list-state--error" role="alert">
    <text class="state-title">订单加载失败</text>
    <text class="state-description">{{errorMessage}}</text>
    <view class="state-action">
      <t-button block loading="{{isLoading}}" disabled="{{isLoading}}" bindtap="retry">重新加载</t-button>
    </view>
  </view>

  <view wx:elif="{{!isLoading && orders.length === 0}}" class="list-state">
    <text class="state-title">没有符合条件的订单</text>
    <text class="state-description">可以切换状态或清空搜索条件后重试</text>
  </view>

  <view wx:else class="order-list">
    <view
      wx:for="{{orders}}"
      wx:key="orderNo"
      class="order-card"
      role="button"
      aria-label="订单 {{item.orderNo}}，{{item.statusLabel}}，{{item.paymentLabel}}"
      data-order-no="{{item.orderNo}}"
      bindtap="onOrderTap"
      hover-class="order-card--pressed"
    >
      <view class="order-card__top">
        <view>
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-time">{{item.createdAtText}}</text>
        </view>
        <text class="status-badge status-badge--{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-customer">
        <text>{{item.pickupName}}</text>
        <text>{{item.maskedPhone}}</text>
      </view>
      <view class="order-card__bottom">
        <text class="payment-badge payment-badge--{{item.paymentStatus}}">{{item.paymentLabel}}</text>
        <text class="order-money">{{item.amountText}}</text>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="feedback-error" role="alert">
      <text>{{errorMessage}}</text>
      <text class="inline-retry" role="button" bindtap="retry">重试</text>
    </view>

    <view wx:if="{{hasMore}}" class="load-more">
      <t-button
        theme="default"
        variant="outline"
        block
        loading="{{isLoadingMore}}"
        disabled="{{isLoadingMore}}"
        bindtap="loadMore"
      >加载更多</t-button>
    </view>
    <text wx:else class="list-end">共 {{total}} 单，已经到底了</text>
  </view>
</view>

<app-tab-bar value="orders" />
