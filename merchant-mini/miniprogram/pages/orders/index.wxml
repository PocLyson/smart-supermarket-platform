<view class="merchant-page-header">
  <view class="merchant-page-header__copy">
    <text class="merchant-page-header__title">订单管理</text>
  </view>
  <view
    class="header-refresh {{isLoading || isSummaryLoading ? 'is-disabled' : ''}}"
    role="button"
    aria-label="刷新订单"
    aria-disabled="{{isLoading || isSummaryLoading}}"
    bindtap="refresh"
    hover-class="header-refresh--pressed"
  >
    <image class="local-icon local-icon--refresh" src="/assets/icons/refresh-cw.svg" mode="aspectFit" aria-hidden="true" />
  </view>
</view>

<view class="order-summary-strip" aria-label="待处理订单概览">
  <view class="summary-metric" data-status="PENDING_CONFIRMATION" bindtap="onStatusTap">
    <text class="summary-metric__label">待接单</text>
    <text class="summary-metric__value">{{pendingCount}}</text>
  </view>
  <view class="summary-metric" data-status="PREPARING" bindtap="onStatusTap">
    <text class="summary-metric__label">备货中</text>
    <text class="summary-metric__value">{{preparingCount}}</text>
  </view>
  <view class="summary-metric" data-status="READY_FOR_PICKUP" bindtap="onStatusTap">
    <text class="summary-metric__label">待取货</text>
    <text class="summary-metric__value">{{readyCount}}</text>
  </view>
</view>

<view class="page-shell orders-page">
  <view class="search-toolbar">
    <view class="search-control">
      <image class="local-icon local-icon--search" src="/assets/icons/search.svg" mode="aspectFit" aria-hidden="true" />
      <input
        class="search-input"
        value="{{draftKeyword}}"
        placeholder="订单号、姓名或手机号"
        confirm-type="search"
        aria-label="订单号、姓名或手机号"
        bindinput="onKeywordInput"
        bindconfirm="search"
      />
    </view>
    <view
      class="search-action {{isLoading || isLoadingMore ? 'is-disabled' : ''}}"
      role="button"
      aria-disabled="{{isLoading || isLoadingMore}}"
      bindtap="search"
      hover-class="control--pressed"
    >查询</view>
    <view
      class="filter-trigger {{isPaymentFilterOpen || selectedPaymentStatus ? 'is-active' : ''}}"
      role="button"
      aria-label="付款状态筛选"
      aria-expanded="{{isPaymentFilterOpen}}"
      aria-disabled="{{isLoading || isLoadingMore}}"
      bindtap="togglePaymentFilter"
      hover-class="control--pressed"
    >
      <image class="local-icon local-icon--filter" src="/assets/icons/list-filter.svg" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <scroll-view class="status-tabs" scroll-x enhanced show-scrollbar="{{false}}" aria-label="订单状态筛选">
    <view class="status-tabs__inner">
      <view
        wx:for="{{statusTabs}}"
        wx:key="value"
        class="status-tab {{selectedStatus === item.value ? 'is-active' : ''}}"
        role="button"
        aria-label="{{item.label}}"
        aria-selected="{{selectedStatus === item.value}}"
        aria-disabled="{{isLoading || isLoadingMore}}"
        data-status="{{item.value}}"
        bindtap="onStatusTap"
        hover-class="control--pressed"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{isPaymentFilterOpen}}" class="payment-filter-panel" aria-label="付款状态筛选">
    <view
      wx:for="{{paymentTabs}}"
      wx:key="value"
      class="payment-tab {{selectedPaymentStatus === item.value ? 'is-active' : ''}}"
      role="button"
      aria-selected="{{selectedPaymentStatus === item.value}}"
      aria-disabled="{{isLoading || isLoadingMore}}"
      data-status="{{item.value}}"
      bindtap="onPaymentTap"
      hover-class="control--pressed"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{isLoading && orders.length === 0}}" class="list-state" role="status" aria-live="polite">
    <t-loading theme="circular" size="48rpx" />
    <text>正在加载订单…</text>
  </view>

  <view wx:elif="{{errorMessage && orders.length === 0}}" class="list-state list-state--error" role="alert">
    <text class="state-title">订单加载失败</text>
    <text class="state-description">{{errorMessage}}</text>
    <view class="state-action">
      <t-button block loading="{{isLoading}}" disabled="{{isLoading}}" bindtap="retry">重新加载</t-button>
    </view>
  </view>

  <view wx:elif="{{!isLoading && orders.length === 0}}" class="list-state">
    <text class="state-title">没有符合条件的订单</text>
    <text class="state-description">可以切换状态或清空搜索条件后重试</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-timeline">
      <view
        wx:for="{{orders}}"
        wx:key="orderNo"
        class="order-card order-card--{{item.status}}"
        role="button"
        aria-label="订单 {{item.orderNo}}，{{item.statusLabel}}，{{item.paymentLabel}}"
        data-order-no="{{item.orderNo}}"
        bindtap="onOrderTap"
        hover-class="order-card--pressed"
      >
        <view class="timeline-marker" aria-hidden="true">
          <image class="local-icon local-icon--marker" src="/assets/icons/circle.svg" mode="aspectFit" />
        </view>
        <view class="order-card__top">
          <view class="order-title-line">
            <text class="status-badge status-badge--{{item.status}}">{{item.statusLabel}}</text>
            <text class="order-no">{{item.orderNo}}</text>
          </view>
          <text class="order-time">{{item.createdAtText}}</text>
        </view>
        <view class="order-card__body">
          <view class="order-customer">
            <text class="customer-name">{{item.pickupName}}</text>
            <text class="customer-phone">{{item.maskedPhone}}</text>
          </view>
          <view class="order-meta">
            <text>共 {{item.items.length}} 件商品</text>
            <text class="payment-badge payment-badge--{{item.paymentStatus}}">{{item.paymentLabel}}</text>
          </view>
        </view>
        <view class="order-card__amount">
          <text class="order-money">{{item.amountText}}</text>
          <image class="local-icon local-icon--chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="feedback-error" role="alert">
      <text>{{errorMessage}}</text>
      <text class="inline-retry" role="button" bindtap="retry">重试</text>
    </view>

    <view wx:if="{{hasMore}}" class="load-more">
      <t-button
        theme="default"
        variant="outline"
        block
        loading="{{isLoadingMore}}"
        disabled="{{isLoadingMore}}"
        bindtap="loadMore"
      >加载更多</t-button>
    </view>
    <text wx:else class="list-end">共 {{total}} 单，已经到底了</text>
  </view>
</view>

<app-tab-bar value="orders" />
