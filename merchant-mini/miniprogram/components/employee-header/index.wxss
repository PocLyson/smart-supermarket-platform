.employee-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.employee-mark {
  position: relative;
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid var(--primary-300);
  border-radius: var(--radius-round);
  background: var(--primary-100);
}

.employee-mark__head {
  position: absolute;
  top: 18rpx;
  left: 31rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid var(--primary-600);
  border-radius: var(--radius-round);
}

.employee-mark__body {
  position: absolute;
  bottom: 16rpx;
  left: 21rpx;
  width: 38rpx;
  height: 20rpx;
  border: 4rpx solid var(--primary-600);
  border-bottom: 0;
  border-radius: 24rpx 24rpx 0 0;
}

.employee-copy,
.employee-name,
.employee-role {
  display: block;
}

.employee-name {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
}

.employee-role {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}
