<view class="app-tab-bar" role="navigation" aria-label="商家端主导航">
  <view
    wx:for="{{items}}"
    wx:key="id"
    class="tab-item {{value === item.id ? 'is-active' : ''}} {{item.id === 'verification' ? 'tab-item--verification' : ''}}"
    role="button"
    aria-label="{{item.label}}{{item.id === 'messages' && unreadCount > 0 ? '，' + unreadCount + '个待回复会话' : ''}}"
    aria-current="{{value === item.id ? 'page' : 'false'}}"
    data-value="{{item.id}}"
    bindtap="onTabTap"
    hover-class="tab-item--pressed"
  >
    <view class="active-indicator" wx:if="{{value === item.id && item.id !== 'verification'}}" aria-hidden="true"></view>
    <view class="tab-icon-shell">
      <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
      <text wx:if="{{item.id === 'messages' && unreadCount > 0}}" class="tab-unread-badge" aria-hidden="true">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
