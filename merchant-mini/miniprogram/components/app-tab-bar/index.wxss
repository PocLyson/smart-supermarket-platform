.app-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  box-sizing: border-box;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-divider);
  background: var(--color-bg-surface);
  box-shadow: 0 -8rpx 24rpx rgba(13, 27, 54, 0.08);
}

.tab-item {
  display: flex;
  min-width: 44px;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  flex-direction: column;
  gap: 4rpx;
  transition: background-color var(--duration-fast) var(--easing-standard), color var(--duration-fast) var(--easing-standard);
}

.tab-icon {
  width: 24px;
  height: 24px;
}

.tab-item--pressed {
  background: var(--color-bg-subtle);
}

.tab-item.is-active {
  background: var(--primary-100);
  color: var(--primary-600);
}

.tab-label {
  font-size: 22rpx;
  font-weight: var(--weight-medium);
  line-height: 30rpx;
  white-space: nowrap;
}
