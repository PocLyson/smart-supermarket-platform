# Copy to deploy/.env.production and replace every placeholder before deployment.
MYSQL_DATABASE=smart_store
MYSQL_USER=smart_store_app
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
REDIS_PASSWORD=replace-with-a-random-redis-password
JWT_SECRET=replace-before-use
WECHAT_APP_ID=replace-with-wechat-mini-program-app-id
WECHAT_APP_SECRET=replace-with-wechat-mini-program-app-secret
TLS_CERT_DIR=./certs-example-only
