{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node",
      "wechat-miniprogram"
    ],
    "skipLibCheck": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
