page {
  /* Brand: approved navy fresh direction */
  --primary-50: #F4F7FC;
  --primary-100: #EAF2FF;
  --primary-200: #CFE0F7;
  --primary-300: #9EBDE5;
  --primary-400: #5D8BC8;
  --primary-500: #245B9E;
  --primary-600: #082F6B;
  --primary-700: #082F6B;
  --primary-800: #062654;
  --primary-900: #041A3B;
  --color-accent-gold: #A16207;
  --color-accent-gold-bg: #FEF3C7;

  /* TDesign MiniProgram theme mapping */
  --td-brand-color-1: #F4F7FC;
  --td-brand-color-2: #EAF2FF;
  --td-brand-color-3: #CFE0F7;
  --td-brand-color-4: #9EBDE5;
  --td-brand-color-5: #5D8BC8;
  --td-brand-color-6: #245B9E;
  --td-brand-color-7: #082F6B;
  --td-brand-color-8: #062654;
  --td-brand-color-9: #041A3B;
  --td-brand-color-10: #021126;
  --td-primary-color-1: var(--td-brand-color-1);
  --td-primary-color-2: var(--td-brand-color-2);
  --td-primary-color-3: var(--td-brand-color-3);
  --td-primary-color-7: var(--td-brand-color-7);
  --td-primary-color-8: var(--td-brand-color-8);
  --td-primary-color-9: var(--td-brand-color-9);
  --td-brand-color: var(--primary-600);
  --td-brand-color-focus: var(--primary-100);
  --td-brand-color-active: var(--primary-800);
  --td-brand-color-disabled: var(--primary-200);
  --td-brand-color-light: var(--primary-100);
  --td-brand-color-light-active: var(--primary-200);
  --td-bg-color-page: #F7F9FC;
  --td-bg-color-container: #FFFFFF;
  --td-bg-color-secondarycontainer: #F1F4F8;
  --td-bg-color-container-active: #EAF2FF;
  --td-text-color-primary: #0D1B36;
  --td-text-color-secondary: #52617A;
  --td-text-color-placeholder: #8290A4;
  --td-border-level-1-color: #E7ECF3;
  --td-border-level-2-color: #D7E0EB;
  --td-component-border: #D7E0EB;
  --td-radius-default: 8rpx;
  --td-radius-medium: 16rpx;
  --td-radius-large: 24rpx;
  --td-tab-bar-bg-color: #FFFFFF;
  --td-tab-bar-border-color: #E7ECF3;
  --td-tab-bar-active-color: #082F6B;
  --td-tab-bar-color: #718096;
  --td-tab-bar-height: 132rpx;

  /* Neutral surfaces and content */
  --color-bg-page: #F7F9FC;
  --color-bg-surface: #FFFFFF;
  --color-bg-overlay: #FFFFFF;
  --color-bg-subtle: #F1F4F8;
  --color-bg-hover: #EAF2FF;
  --color-text-primary: #0D1B36;
  --color-text-secondary: #52617A;
  --color-text-tertiary: #718096;
  --color-text-placeholder: #8290A4;
  --color-border-default: #E7ECF3;
  --color-border-control: #C9D4E2;
  --color-divider: #E7ECF3;
  --color-mask: rgba(13, 27, 54, 0.48);
  --color-disabled-bg: #E9EEF5;
  --color-disabled-text: #8B98AA;
  --color-price: #E5484D;

  /* Semantic feedback */
  --color-success: #2E9B62;
  --color-success-bg: #ECF8F2;
  --color-success-border: #9BD4B7;
  --color-success-text: #1D7146;
  --color-success-icon: #2E9B62;
  --color-warning: #B16A00;
  --color-warning-bg: #FFF7E6;
  --color-warning-border: #E6B866;
  --color-warning-text: #754600;
  --color-warning-icon: #9A5C00;
  --color-error: #C2412D;
  --color-error-bg: #FFF2ED;
  --color-error-border: #EDAA9A;
  --color-error-text: #7C2D20;
  --color-error-icon: #B53B29;
  --color-info: #2563A6;
  --color-info-bg: #EEF5FC;
  --color-info-border: #94BCE4;
  --color-info-text: #184A7A;
  --color-info-icon: #2563A6;

  /* Order and payment states */
  --status-pending-bg: #FFF7E6;
  --status-pending-text: #754600;
  --status-pending-border: #E6B866;
  --status-preparing-bg: #EEF5FC;
  --status-preparing-text: #184A7A;
  --status-preparing-border: #94BCE4;
  --status-ready-bg: #F5F0FA;
  --status-ready-text: #5B3F83;
  --status-ready-border: #C8B5DD;
  --status-completed-bg: #ECF8F2;
  --status-completed-text: #15543E;
  --status-completed-border: #86C7AD;
  --status-cancelled-bg: #FFF2ED;
  --status-cancelled-text: #7C2D20;
  --status-cancelled-border: #EDAA9A;
  --payment-unpaid-bg: #FFF7E6;
  --payment-unpaid-text: #754600;
  --payment-unpaid-border: #E6B866;
  --payment-paid-bg: #ECF8F2;
  --payment-paid-text: #15543E;
  --payment-paid-border: #86C7AD;

  /* Native mini-program typography */
  --font-family-base: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
  --type-caption-size: 24rpx;
  --type-caption-line: 36rpx;
  --type-helper-size: 28rpx;
  --type-helper-line: 44rpx;
  --type-body-size: 32rpx;
  --type-body-line: 48rpx;
  --type-label-size: 28rpx;
  --type-label-line: 44rpx;
  --type-button-size: 32rpx;
  --type-button-line: 48rpx;
  --type-card-title-size: 34rpx;
  --type-card-title-line: 52rpx;
  --type-section-title-size: 40rpx;
  --type-section-title-line: 56rpx;
  --type-page-title-size: 48rpx;
  --type-page-title-line: 68rpx;
  --type-money-size: 48rpx;
  --type-money-line: 60rpx;
  --type-data-size: 40rpx;
  --type-data-line: 56rpx;
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* Radius */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-round: 19998rpx;

  /* 4px / 8px spacing rhythm */
  --space-0: 0;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-7: 56rpx;
  --space-8: 64rpx;
  --space-10: 80rpx;
  --space-12: 96rpx;
  --space-16: 128rpx;

  /* Borders, focus, elevation and mask */
  --border-width-default: 2rpx;
  --border-color-default: #E7ECF3;
  --border-color-control: #C9D4E2;
  --border-color-focus: #082F6B;
  --shadow-focus: 0 0 0 4rpx #FFFFFF, 0 0 0 8rpx #9EBDE5;
  --shadow-card: 0 6rpx 20rpx rgba(13, 27, 54, 0.06);
  --shadow-dropdown: 0 16rpx 48rpx rgba(13, 27, 54, 0.12);
  --shadow-modal: 0 32rpx 80rpx rgba(13, 27, 54, 0.18);
  --overlay-mask: rgba(13, 27, 54, 0.48);

  /* Controls, media and motion */
  --size-touch-min: 88rpx;
  --size-product-thumb: 180rpx;
  --size-product-hero: 560rpx;
  --duration-fast: 150ms;
  --duration-normal: 200ms;
  --easing-standard: ease-out;
}
