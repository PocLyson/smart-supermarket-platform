.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-5) var(--space-4) calc(var(--space-12) + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: var(--space-5);
  padding: var(--space-5);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
}

.section-title {
  margin-bottom: var(--space-2);
  color: var(--color-text-primary);
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-section-title-line);
}

.muted {
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  font-weight: var(--weight-regular);
  line-height: var(--type-helper-line);
}

.price {
  color: var(--color-price);
  font-size: var(--type-money-size);
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
  line-height: var(--type-money-line);
}

.button-primary,
.button-secondary,
.button-danger,
.button-text {
  box-sizing: border-box;
  min-width: var(--size-touch-min);
  min-height: var(--size-touch-min);
  padding: var(--space-3) var(--space-4);
  border-width: var(--border-width-default);
  border-style: solid;
  border-radius: var(--radius-md);
  font-size: var(--type-button-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-button-line);
  transition:
    background-color var(--duration-fast) var(--easing-standard),
    border-color var(--duration-fast) var(--easing-standard),
    color var(--duration-fast) var(--easing-standard);
}

.button-primary::after,
.button-secondary::after,
.button-danger::after,
.button-text::after {
  border: 0;
}

.button-primary {
  border-color: var(--primary-600);
  background: var(--primary-600);
  color: var(--color-bg-surface);
}

.button-primary.button-hover {
  border-color: var(--primary-800);
  background: var(--primary-800);
}

.button-primary[disabled],
.button-secondary[disabled],
.button-danger[disabled] {
  border-color: var(--color-border-default);
  background: var(--color-disabled-bg);
  color: var(--color-disabled-text);
  opacity: 1;
}

.button-secondary {
  border-color: var(--color-border-control);
  background: var(--color-bg-surface);
  color: var(--color-text-primary);
}

.button-secondary.button-hover {
  background: var(--color-disabled-bg);
}

.button-danger {
  border-color: var(--color-error);
  background: var(--color-error);
  color: var(--color-bg-surface);
}

.button-danger.button-hover {
  border-color: var(--color-error-text);
  background: var(--color-error-text);
}

.button-text {
  border-color: transparent;
  background: transparent;
  color: var(--primary-700);
}

.button-text.button-hover {
  background: var(--primary-100);
  color: var(--primary-800);
}

.button-primary:focus,
.button-secondary:focus,
.button-danger:focus,
.button-text:focus,
.field:focus {
  border-color: var(--border-color-focus);
  box-shadow: var(--shadow-focus);
}

.is-disabled {
  border-color: var(--color-border-default);
  background: var(--color-disabled-bg);
  color: var(--color-disabled-text);
}

.is-out-of-stock {
  color: var(--color-danger);
}

.out-of-stock-action {
  font-size: 20rpx;
  font-weight: var(--weight-semibold);
  white-space: nowrap;
}

.state-panel {
  margin-bottom: var(--space-4);
  padding: var(--space-8) var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-bg-subtle);
  color: var(--color-text-secondary);
  text-align: center;
}

.state-panel button {
  margin-top: var(--space-3);
}

.page-intro {
  margin-bottom: var(--space-5);
}

.page-title {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--type-page-title-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-page-title-line);
}

.page-description {
  display: block;
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.field {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--size-touch-min);
  padding: var(--space-3) var(--space-4);
  border: var(--border-width-default) solid var(--color-border-control);
  border-radius: var(--radius-md);
  background: var(--color-bg-surface);
  color: var(--color-text-primary);
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
}

.field-placeholder {
  color: var(--color-text-placeholder);
}

.form-field,
.order-line {
  margin-bottom: var(--space-5);
}

.status-tag,
.payment-tag {
  display: inline-flex;
  align-items: center;
  min-height: var(--type-label-line);
  padding: var(--space-1) var(--space-2);
  border-width: var(--border-width-default);
  border-style: solid;
  border-radius: var(--radius-sm);
  font-size: var(--type-label-size);
  font-weight: var(--weight-medium);
  line-height: var(--type-label-line);
}

.status-PENDING_CONFIRMATION {
  border-color: var(--status-pending-border);
  background: var(--status-pending-bg);
  color: var(--status-pending-text);
}

.payment-UNPAID {
  border-color: var(--payment-unpaid-border);
  background: var(--payment-unpaid-bg);
  color: var(--payment-unpaid-text);
}

.status-PREPARING {
  border-color: var(--status-preparing-border);
  background: var(--status-preparing-bg);
  color: var(--status-preparing-text);
}

.status-READY_FOR_PICKUP {
  border-color: var(--status-ready-border);
  background: var(--status-ready-bg);
  color: var(--status-ready-text);
}

.status-COMPLETED {
  border-color: var(--status-completed-border);
  background: var(--status-completed-bg);
  color: var(--status-completed-text);
}

.payment-PAID {
  border-color: var(--payment-paid-border);
  background: var(--payment-paid-bg);
  color: var(--payment-paid-text);
}

.status-CANCELLED {
  border-color: var(--status-cancelled-border);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--space-3);
}
