.app-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 12rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e8e1e3;
  box-shadow: 0 -8rpx 24rpx rgba(69, 21, 32, 0.05);
}

.tab-item {
  display: flex;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  color: #6f666a;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
}

.tab-item.is-active {
  color: #8e2f3f;
}
