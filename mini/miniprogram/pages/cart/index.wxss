.cart-page {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.cart-item {
  padding: var(--space-4);
}

.cart-item-top {
  align-items: flex-start;
}

.cart-select {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  gap: var(--space-3);
}

.cart-image {
  width: 176rpx;
  height: 176rpx;
  flex: none;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
}

.cart-product-copy {
  display: flex;
  min-width: 0;
  min-height: 176rpx;
  flex: 1;
  flex-direction: column;
}

.cart-name {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.cart-service {
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
}

.cart-price {
  margin-top: auto;
  color: var(--primary-600);
  font-size: 38rpx;
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
}

.cart-remove {
  min-width: var(--size-touch-min);
  min-height: var(--size-touch-min);
  margin: 0;
  padding: 0 var(--space-2);
  border: 0;
  background: transparent;
  color: var(--color-error-text);
  font-size: var(--type-helper-size);
}

.cart-remove::after {
  border: 0;
}

.cart-item-bottom {
  margin-top: var(--space-4);
  padding-left: 64rpx;
}

.quantity-stepper {
  overflow: hidden;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-md);
  gap: 0;
}

.quantity-button {
  min-width: var(--size-touch-min);
  min-height: 72rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: var(--color-bg-subtle);
}

.quantity-button.quantity-disabled {
  background: var(--color-disabled-bg);
  color: var(--color-disabled-text);
}

.quantity-value {
  min-width: 72rpx;
  color: var(--color-text-primary);
  font-size: var(--type-body-size);
  font-variant-numeric: tabular-nums;
  line-height: 72rpx;
  text-align: center;
}

.cart-summary-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  left: 0;
  display: flex;
  box-sizing: border-box;
  min-height: 136rpx;
  padding: var(--space-3) var(--space-4);
  border-top: var(--border-width-default) solid var(--color-divider);
  background: var(--color-bg-surface);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.cart-summary-copy {
  min-width: 0;
  flex: 1;
}

.summary-label {
  margin-right: var(--space-2);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.checkout-button {
  min-width: 224rpx;
  margin: 0;
}

.cart-empty {
  display: flex;
  min-height: 680rpx;
  padding: var(--space-8) var(--space-4);
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 112rpx;
  height: 112rpx;
  opacity: 0.62;
}

.empty-title {
  margin-top: var(--space-4);
  color: var(--color-text-primary);
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-semibold);
}

.empty-copy {
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.empty-action {
  min-width: 240rpx;
  margin-top: var(--space-5);
}
