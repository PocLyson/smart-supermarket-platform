<view class="page-shell">
  <view wx:if="{{loading}}" class="state-panel">加载中...</view>
  <view wx:elif="{{error && !order}}" class="state-panel">
    <text>{{error}}</text>
    <button class="button-secondary" size="mini" bindtap="loadOrder">重试</button>
  </view>
  <view wx:elif="{{order}}">
    <view class="card">
      <view class="row-between">
        <text class="section-title">{{orderStatusLabel[order.status]}}</text>
        <text>{{paymentStatusLabel[order.paymentStatus]}}</text>
      </view>
      <view class="muted">订单号 {{order.orderNo}}</view>
      <view>取货人：{{order.pickupName}}</view>
      <view>手机号：{{order.phone}}</view>
      <view wx:if="{{order.cancellationReason}}">取消原因：{{order.cancellationReason}}</view>
    </view>

    <view class="card">
      <view class="section-title">商品快照</view>
      <view wx:for="{{order.items}}" wx:key="productId" class="row-between order-line">
        <text>{{item.productName}} × {{item.quantity}}</text>
        <text>¥{{item.subtotalCent / 100}}</text>
      </view>
      <view class="row-between">
        <text>订单合计</text>
        <text class="price">¥{{order.totalCent / 100}}</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">状态记录</view>
      <view wx:for="{{order.history}}" wx:key="index" class="order-line">
        <view>{{orderStatusLabel[item.status]}}</view>
        <view class="muted">{{item.createdAt}}</view>
        <view wx:if="{{item.reason}}" class="muted">{{item.reason}}</view>
      </view>
    </view>

    <view wx:if="{{error}}" class="state-panel">{{error}}</view>
    <button wx:if="{{canCancel}}" class="button-danger" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="onCancel">取消订单</button>
  </view>
</view>
