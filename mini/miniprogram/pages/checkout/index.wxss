.checkout-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.checkout-section {
  padding: var(--space-5);
}

.pickup-heading {
  align-items: center;
}

.pickup-heading .section-title {
  margin-bottom: 0;
}

.pickup-edit {
  display: flex;
  min-width: var(--size-touch-min);
  min-height: var(--size-touch-min);
  color: var(--primary-600);
  font-size: var(--type-helper-size);
  align-items: center;
  justify-content: flex-end;
}

.pickup-loading {
  display: flex;
  min-height: 144rpx;
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  align-items: center;
  justify-content: center;
}

.pickup-info-row:first-of-type {
  margin-top: var(--space-3);
}

.pickup-value {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.field-helper {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.pickup-missing {
  display: flex;
  min-height: 240rpx;
  padding-top: var(--space-3);
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pickup-missing-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
}

.pickup-missing-copy {
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.pickup-action {
  display: flex;
  box-sizing: border-box;
  min-width: 240rpx;
  min-height: 72rpx;
  margin-top: var(--space-4);
  padding: 0 var(--space-5);
  line-height: 1;
  align-items: center;
  justify-content: center;
}

.checkout-heading {
  margin-bottom: var(--space-2);
  align-items: baseline;
}

.checkout-heading .section-title {
  margin-bottom: 0;
}

.checkout-product-image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
}

.checkout-product-copy {
  min-width: 0;
  flex: 1;
}

.checkout-product-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-line-price {
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  font-weight: var(--weight-medium);
}

.checkout-info-row {
  display: flex;
  min-height: 88rpx;
  border-top: var(--border-width-default) solid var(--color-divider);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  align-items: center;
  justify-content: space-between;
}

.checkout-notice {
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-warning-bg);
  color: var(--color-warning-text);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.error-banner {
  display: flex;
  margin-bottom: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border: var(--border-width-default) solid var(--color-error-border);
  border-radius: var(--radius-md);
  background: var(--color-error-bg);
  color: var(--color-error-text);
  font-size: var(--type-helper-size);
  flex-direction: column;
}

.error-banner-title {
  font-weight: var(--weight-semibold);
}

.checkout-submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  min-height: 144rpx;
  padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
  border-top: var(--border-width-default) solid var(--color-divider);
  background: var(--color-bg-surface);
  align-items: center;
  gap: var(--space-3);
}

.checkout-total {
  min-width: 0;
  flex: 1;
}

.summary-label {
  margin-right: var(--space-2);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.total-helper {
  display: block;
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
}

.checkout-submit {
  min-width: 232rpx;
  margin: 0;
}
