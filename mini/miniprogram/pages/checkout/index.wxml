<view class="page-shell">
  <view class="page-intro">
    <text class="page-title">确认订单</text>
    <text class="page-description">填写取货信息并核对商品</text>
  </view>
  <view class="card checkout-section">
    <view class="section-title">取货信息</view>
    <label class="field-label">取货人姓名</label>
    <input class="field form-field" placeholder-class="field-placeholder" value="{{pickupName}}" maxlength="40" placeholder="请输入取货人姓名" bindinput="onPickupNameInput" />
    <label class="field-label">手机号码</label>
    <input class="field form-field" placeholder-class="field-placeholder" value="{{phone}}" type="number" maxlength="11" placeholder="请输入11位手机号" bindinput="onPhoneInput" />
  </view>

  <view class="card checkout-section">
    <view class="section-title">商品清单</view>
    <view wx:for="{{items}}" wx:key="productId" class="row-between order-line">
      <text class="checkout-product-name">{{item.name}} × {{item.quantity}}</text>
      <text class="checkout-line-price">¥{{item.unitPriceCent * item.quantity / 100}}</text>
    </view>
    <view class="row-between">
      <text>预计合计</text>
      <text class="price">¥{{totalCent / 100}}</text>
    </view>
    <view class="muted">最终金额以服务端下单结果为准</view>
  </view>

  <view wx:if="{{error}}" class="state-panel">{{error}}</view>
  <button class="button-primary checkout-submit {{submitting || !items.length ? 'is-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting || !items.length}}" bindtap="onSubmit">提交订单</button>
</view>
