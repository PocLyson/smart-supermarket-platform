<view class="page-shell checkout-page">
  <view class="page-intro">
    <text class="page-title">确认订单</text>
    <text class="page-description">核对取货信息与商品</text>
  </view>
  <view class="card checkout-section">
    <view class="row-between pickup-heading">
      <view class="section-title">取货信息</view>
      <view wx:if="{{pickupReady}}" class="pickup-edit" role="button" bindtap="onEditPickup">修改</view>
    </view>
    <view wx:if="{{profileLoading}}" class="pickup-loading">正在读取默认取货信息...</view>
    <block wx:elif="{{pickupReady}}">
      <view class="checkout-info-row pickup-info-row"><text>取货人</text><text class="pickup-value">{{pickupName}}</text></view>
      <view class="checkout-info-row pickup-info-row"><text>手机号码</text><text class="pickup-value">{{phone}}</text></view>
      <text class="field-helper">可在设置中修改</text>
    </block>
    <view wx:else class="pickup-missing">
      <text class="pickup-missing-title">{{profileError ? '取货信息暂时无法读取' : '请先完善取货信息'}}</text>
      <text class="pickup-missing-copy">{{profileError || '保存一次后，后续下单将自动使用'}}</text>
      <view wx:if="{{profileError}}" class="button-secondary pickup-action" role="button" bindtap="onRetryProfile">重新加载</view>
      <view wx:else class="button-primary pickup-action" role="button" bindtap="onEditPickup">完善取货信息</view>
    </view>
  </view>

  <view class="card checkout-section">
    <view class="row-between checkout-heading">
      <view class="section-title">商品清单</view>
      <text class="muted">共 {{items.length}} 种</text>
    </view>
    <view wx:for="{{items}}" wx:key="productId" class="row-between order-line">
      <image class="checkout-product-image" src="{{imageFailed ? '/assets/icons/image-placeholder.svg' : (item.coverImageUrl || '/assets/icons/image-placeholder.svg')}}" mode="aspectFill" lazy-load binderror="onImageError" />
      <view class="checkout-product-copy">
        <text class="checkout-product-name">{{item.name}}</text>
        <text class="muted">数量 × {{item.quantity}}</text>
      </view>
      <text class="checkout-line-price">{{item.displaySubtotal}}</text>
    </view>
  </view>

  <view class="card checkout-section">
    <view class="section-title">取货与付款</view>
    <view class="checkout-info-row"><text>取货方式</text><text>到店自取</text></view>
    <view class="checkout-info-row"><text>取货门店</text><text>鲁能超市李老家分店</text></view>
    <view class="checkout-info-row"><text>付款方式</text><text>到店付款</text></view>
    <view class="checkout-notice">支持现金或门店微信收款码，本小程序不收取线上款项。</view>
  </view>

  <view wx:if="{{error}}" class="error-banner" role="alert">
    <text class="error-banner-title">订单提交失败</text>
    <text>{{error}}</text>
  </view>

  <view class="checkout-submit-bar">
    <view class="checkout-total">
      <view><text class="summary-label">应付合计</text><text class="price">{{displayTotal}}</text></view>
      <text class="total-helper">以服务端最终校验为准</text>
    </view>
    <button class="button-primary checkout-submit {{submitting || profileLoading || !pickupReady || !items.length ? 'is-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting || profileLoading || !pickupReady || !items.length}}" bindtap="onSubmit">{{submitting ? '正在提交' : '提交订单'}}</button>
  </view>
</view>
