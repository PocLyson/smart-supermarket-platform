<view class="auth-page">
  <view class="auth-card">
    <view class="wechat-mark"><text>WX</text></view>
    <text class="auth-title">登录后享受完整服务</text>
    <text class="auth-copy">同步订单与购物车，保存取货信息，并查看历史订单。</text>

    <view class="permission-list">
      <view class="permission-row">
        <image class="permission-icon" src="/assets/icons/user.svg" mode="aspectFit" />
        <view><text class="permission-title">微信登录凭证</text><text class="permission-copy">仅用于识别账号并建立登录会话</text></view>
      </view>
      <view class="permission-row">
        <image class="permission-icon" src="/assets/icons/order.svg" mode="aspectFit" />
        <view><text class="permission-title">订单与取货信息</text><text class="permission-copy">姓名和手机号仅在你主动填写后保存</text></view>
      </view>
    </view>

    <view class="consent-row" role="checkbox" aria-checked="{{agreed}}" bindtap="onToggleConsent">
      <view class="consent-checkbox {{agreed ? 'is-checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="consent-copy">
        <text>我已阅读并同意</text>
        <text class="legal-link" data-type="terms" catchtap="onOpenLegal">《用户服务协议》</text>
        <text>和</text>
        <text class="legal-link" data-type="privacy" catchtap="onOpenLegal">《隐私政策》</text>
      </view>
    </view>

    <button class="button-primary auth-primary" loading="{{loading}}" disabled="{{loading || !agreed}}" bindtap="onAuthorize">{{loading ? '正在登录' : '微信登录'}}</button>
    <button class="button-secondary auth-secondary" disabled="{{loading}}" bindtap="onCancel">暂不登录</button>
    <text wx:if="{{error}}" class="auth-error" role="alert">{{error}}</text>
    <text class="auth-legal">你可以暂不登录并继续浏览商品</text>
  </view>
</view>
