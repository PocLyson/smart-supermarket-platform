.profile-page {
  min-height: 100vh;
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
}

.profile-hero {
  box-sizing: border-box;
  min-height: 324rpx;
  padding: calc(env(safe-area-inset-top) + 112rpx) var(--space-4) var(--space-7);
  background: var(--primary-600);
  color: #FFFFFF;
}

.profile-title {
  margin-bottom: var(--space-5);
  font-size: 36rpx;
  font-weight: var(--weight-bold);
}

.profile-identity {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  gap: var(--space-3);
}

.profile-avatar {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border: 3rpx solid rgba(255, 255, 255, 0.76);
  border-radius: var(--radius-round);
  background: rgba(255, 255, 255, 0.12);
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  width: 64rpx;
  height: 64rpx;
  filter: brightness(0) invert(1);
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-name {
  font-size: 38rpx;
  font-weight: var(--weight-bold);
  line-height: 52rpx;
}

.profile-summary {
  margin-top: var(--space-1);
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.profile-login-button {
  display: flex;
  width: 240rpx;
  height: 88rpx;
  min-width: 240rpx;
  min-height: 88rpx;
  flex: 0 0 240rpx;
  margin: 0;
  padding: 0 var(--space-3);
  border: 0;
  border-radius: var(--radius-round);
  background: #FFFFFF;
  color: var(--primary-600);
  font-size: 26rpx;
  font-weight: var(--weight-semibold);
  line-height: 1;
  align-items: center;
  justify-content: center;
}

.profile-login-button::after {
  border: 0;
}

.profile-content {
  margin-top: -48rpx;
  padding: 0 var(--space-4);
}

.profile-card {
  margin-bottom: var(--space-5);
  padding: var(--space-5);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  box-shadow: var(--shadow-card);
}

.orders-card {
  min-height: 268rpx;
}

.order-card-heading {
  margin-bottom: var(--space-5);
}

.card-title,
.card-description {
  display: block;
}

.card-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
}

.all-orders {
  display: flex;
  min-height: 88rpx;
  color: var(--primary-600);
  font-size: var(--type-caption-size);
  align-items: center;
}

.all-orders-icon {
  width: 30rpx;
  height: 30rpx;
}

.order-status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2);
}

.order-status-item {
  display: flex;
  min-height: 120rpx;
  color: var(--color-text-primary);
  font-size: 22rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
}

.order-status-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.72;
}

.order-status-item.is-highlight {
  color: var(--primary-600);
}

.order-status-item.is-highlight .order-status-icon {
  opacity: 1;
}

.service-row {
  display: flex;
  min-height: 96rpx;
  border-top: var(--border-width-default) solid var(--color-divider);
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  align-items: center;
  justify-content: space-between;
}

.service-value {
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.card-description {
  margin: var(--space-1) 0 var(--space-4);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.field-label {
  display: block;
  margin-bottom: var(--space-2);
  color: var(--color-text-primary);
  font-size: var(--type-label-size);
  font-weight: var(--weight-medium);
}

.profile-field {
  margin-bottom: var(--space-4);
}

.field-error {
  border-color: var(--color-error);
  background: var(--color-error-bg);
}

.field-error-copy {
  display: block;
  margin: calc(var(--space-3) * -1) 0 var(--space-4);
  color: var(--color-error-text);
  font-size: var(--type-helper-size);
}

.profile-error {
  display: flex;
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  border: var(--border-width-default) solid var(--color-error-border);
  border-radius: var(--radius-md);
  background: var(--color-error-bg);
  color: var(--color-error-text);
  font-size: var(--type-helper-size);
  flex-direction: column;
}

.profile-error-title {
  font-weight: var(--weight-semibold);
}

.profile-retry {
  margin-top: var(--space-3);
}

.settings-card {
  display: flex;
  box-sizing: border-box;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
}

.settings-card-hover {
  background: var(--primary-50);
}

.settings-link {
  display: flex;
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  align-items: center;
  gap: var(--space-1);
}

.settings-link-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}
