.profile-page {
  min-height: 100vh;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
}

.profile-hero {
  display: flex;
  min-height: 240rpx;
  padding: var(--space-6) var(--space-4);
  background: var(--primary-600);
  color: #FFFFFF;
  align-items: center;
  gap: var(--space-3);
}

.profile-avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-round);
  background: rgba(255, 255, 255, 0.16);
  font-size: 44rpx;
  font-weight: var(--weight-bold);
  align-items: center;
  justify-content: center;
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-name {
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-section-title-line);
}

.profile-summary {
  margin-top: var(--space-1);
  color: rgba(255, 255, 255, 0.76);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.login-button {
  flex: none;
}

.profile-content {
  padding: var(--space-4);
}

.profile-card {
  margin-bottom: var(--space-4);
  padding: var(--space-5);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-lg);
  background: var(--color-bg-surface);
  box-shadow: var(--shadow-card);
}

.profile-card-hover {
  border-color: var(--primary-200);
  background: var(--primary-50);
}

.order-entry {
  display: flex;
  min-height: 128rpx;
  align-items: center;
  justify-content: space-between;
}

.card-title,
.card-description {
  display: block;
}

.card-title {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
}

.card-description {
  margin: var(--space-1) 0 var(--space-4);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.order-entry .card-description {
  margin-bottom: 0;
}

.entry-arrow {
  color: var(--primary-600);
  font-size: 52rpx;
  line-height: 64rpx;
}

.field-label {
  display: block;
  margin-bottom: var(--space-2);
  color: var(--color-text-primary);
  font-size: var(--type-label-size);
  font-weight: var(--weight-medium);
  line-height: var(--type-label-line);
}

.profile-field {
  margin-bottom: var(--space-4);
}

.save-button {
  margin-top: var(--space-1);
}

.service-row {
  display: flex;
  min-height: var(--size-touch-min);
  border-top: var(--border-width-default) solid var(--color-divider);
  align-items: center;
  justify-content: space-between;
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
}

.logout-button {
  min-height: var(--size-touch-min);
  margin: var(--space-6) 0 0;
  border: 0;
  background: transparent;
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.logout-button::after {
  border: 0;
}
