<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-avatar" aria-label="用户头像">我</view>
    <view class="profile-copy">
      <text class="profile-name">{{displayName}}</text>
      <text class="profile-summary">{{pickupSummary}}</text>
    </view>
    <t-button wx:if="{{!loggedIn}}" t-class="login-button" theme="light" loading="{{loading}}" disabled="{{loading}}" bind:tap="onLogin">微信登录</t-button>
  </view>

  <view class="profile-content">
    <view class="profile-card order-entry" role="button" aria-label="查看我的订单" hover-class="profile-card-hover" bindtap="onOrders">
      <view>
        <text class="card-title">我的订单</text>
        <text class="card-description">查看备货、付款和取货状态</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view wx:if="{{loggedIn}}" class="profile-card">
      <text class="card-title">默认取货信息</text>
      <text class="card-description">下单时自动填写，也可以随时修改</text>
      <label class="field-label">取货人姓名</label>
      <input class="field profile-field {{pickupNameError ? 'field-error' : ''}}" value="{{pickupName}}" maxlength="40" placeholder="请输入取货人姓名" placeholder-class="field-placeholder" bindinput="onPickupNameInput" />
      <text wx:if="{{pickupNameError}}" class="field-error-copy" role="alert">{{pickupNameError}}</text>
      <label class="field-label">手机号码</label>
      <input class="field profile-field {{phoneError ? 'field-error' : ''}}" value="{{phone}}" type="number" maxlength="11" placeholder="请输入11位手机号" placeholder-class="field-placeholder" bindinput="onPhoneInput" />
      <text wx:if="{{phoneError}}" class="field-error-copy" role="alert">{{phoneError}}</text>
      <t-button t-class="save-button" theme="primary" block loading="{{saving}}" disabled="{{saving}}" bind:tap="onSave">保存取货信息</t-button>
    </view>

    <view wx:else class="profile-card login-guide">
      <text class="card-title">登录后享受完整服务</text>
      <text class="card-description">保存取货信息、查看历史订单，购物更省心</text>
      <t-button theme="primary" block loading="{{loading}}" disabled="{{loading}}" bind:tap="onLogin">微信一键登录</t-button>
    </view>

    <view class="profile-card store-service">
      <text class="card-title">门店服务</text>
      <view class="service-row"><text>当前门店</text><text>鲁能超市李老家分店</text></view>
      <view class="service-row"><text>取货方式</text><text>到店自取</text></view>
    </view>

    <view wx:if="{{error}}" class="profile-error" role="alert">
      <text class="profile-error-title">资料加载失败</text>
      <text>{{error}}</text>
      <button class="button-secondary profile-retry" bindtap="onRetry">重新加载</button>
    </view>
    <button wx:if="{{loggedIn}}" class="logout-button" bindtap="onLogout">退出登录</button>
  </view>

  <app-tab-bar value="profile" />
</view>
