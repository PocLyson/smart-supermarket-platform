<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-title">我的</view>
    <view class="profile-identity">
      <view class="profile-avatar" aria-label="用户头像"><image class="profile-avatar-icon" src="/assets/icons/user.svg" mode="aspectFit" /></view>
      <view class="profile-copy">
        <text class="profile-name">{{displayName}}</text>
        <text class="profile-summary">{{pickupSummary}}</text>
      </view>
      <button wx:if="{{!loggedIn}}" class="profile-login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">微信登录</button>
    </view>
  </view>

  <view class="profile-content">
    <view class="profile-card orders-card">
      <view class="row-between order-card-heading" role="button" bindtap="onOrders">
        <text class="card-title">我的订单</text>
        <view class="all-orders">
          <text>全部订单</text>
          <image class="all-orders-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="order-status-grid">
        <view class="order-status-item" role="button" data-status="PENDING_CONFIRMATION" bindtap="onOrderStatus">
          <text wx:if="{{orderCounts.pendingConfirmation > 0}}" class="order-status-badge">{{orderCounts.pendingConfirmation}}</text>
          <image class="order-status-icon" src="/assets/icons/order.svg" mode="aspectFit" /><text>待确认</text>
        </view>
        <view class="order-status-item" role="button" data-status="PREPARING" bindtap="onOrderStatus">
          <text wx:if="{{orderCounts.preparing > 0}}" class="order-status-badge">{{orderCounts.preparing}}</text>
          <image class="order-status-icon" src="/assets/icons/order.svg" mode="aspectFit" /><text>备货中</text>
        </view>
        <view class="order-status-item" role="button" data-status="READY_FOR_PICKUP" bindtap="onOrderStatus">
          <text wx:if="{{orderCounts.readyForPickup > 0}}" class="order-status-badge">{{orderCounts.readyForPickup}}</text>
          <image class="order-status-icon" src="/assets/icons/order.svg" mode="aspectFit" /><text>待取货</text>
        </view>
        <view class="order-status-item" role="button" data-status="COMPLETED" bindtap="onOrderStatus">
          <image class="order-status-icon" src="/assets/icons/order.svg" mode="aspectFit" /><text>已完成</text>
        </view>
      </view>
    </view>

    <view class="profile-card store-service">
      <text class="card-title">门店服务</text>
      <view class="service-row"><text>当前门店</text><text class="service-value">鲁能超市李老家分店</text></view>
      <view class="service-row"><text>取货方式</text><text class="service-value">到店自取</text></view>
      <view wx:if="{{loggedIn}}" class="merchant-contact-actions">
        <button class="merchant-contact-button is-secondary" bindtap="onContactStore">联系在线客服</button>
        <button class="merchant-contact-button is-primary" bindtap="onCallStore">拨打门店电话</button>
      </view>
    </view>

    <view class="profile-card settings-card" role="button" hover-class="settings-card-hover" bindtap="onSettings">
      <text class="card-title">设置</text>
      <view class="settings-link">
        <text>账号设置</text>
        <image class="settings-link-icon" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{error}}" class="profile-error" role="alert">
      <text class="profile-error-title">资料加载失败</text>
      <text>{{error}}</text>
      <button class="button-secondary profile-retry" bindtap="onRetry">重新加载</button>
    </view>
  </view>

  <app-tab-bar value="profile" />
</view>
