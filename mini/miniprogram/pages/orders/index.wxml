<view class="page-shell">
  <view class="page-intro orders-header">
    <text class="page-title">我的订单</text>
  </view>
  <view class="order-filters">
    <view class="order-filter {{selectedStatus === 'ALL' ? 'is-active' : ''}}" data-status="ALL" bindtap="onFilterTap">全部</view>
    <view class="order-filter {{selectedStatus === 'PENDING_CONFIRMATION' ? 'is-active' : ''}}" data-status="PENDING_CONFIRMATION" bindtap="onFilterTap">待确认</view>
    <view class="order-filter {{selectedStatus === 'PREPARING' ? 'is-active' : ''}}" data-status="PREPARING" bindtap="onFilterTap">备货中</view>
    <view class="order-filter {{selectedStatus === 'READY_FOR_PICKUP' ? 'is-active' : ''}}" data-status="READY_FOR_PICKUP" bindtap="onFilterTap">待取货</view>
  </view>
  <view wx:if="{{authRequired}}" class="state-panel orders-auth-required">
    <image class="orders-state-icon" src="/assets/icons/user.svg" mode="aspectFit" />
    <text class="orders-state-title">登录后查看订单</text>
    <text class="orders-state-copy">登录后可查看订单状态和历史记录</text>
    <view class="button-primary orders-state-action" role="button" hover-class="orders-state-action-hover" bindtap="onLogin">微信登录</view>
    <view class="orders-state-secondary" role="button" hover-class="orders-state-secondary-hover" bindtap="onBackToProfile">返回我的</view>
  </view>
  <view wx:elif="{{error}}" class="state-panel">
    <image class="orders-state-icon" src="/assets/icons/close-circle.svg" mode="aspectFit" />
    <text class="orders-state-title">订单加载失败</text>
    <text class="orders-state-copy">{{error}}</text>
    <view class="button-secondary orders-state-action" role="button" hover-class="orders-state-action-hover" data-reset="true" bindtap="loadOrders">重新加载</view>
  </view>
  <view wx:elif="{{loading && !orders.length}}" class="orders-skeleton">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="card skeleton-order">
      <view class="skeleton-block skeleton-line"></view>
      <view class="skeleton-block skeleton-line short"></view>
      <view class="skeleton-block skeleton-total"></view>
    </view>
  </view>
  <view wx:elif="{{empty}}" class="state-panel orders-empty">
    <image class="orders-state-icon" src="/assets/icons/order.svg" mode="aspectFit" />
    <text class="orders-state-title">还没有订单</text>
    <text class="orders-state-copy">挑选商品并提交订单后，进度会显示在这里</text>
    <view class="button-primary orders-state-action" role="button" hover-class="orders-state-action-hover" bindtap="onGoShopping">去逛逛</view>
  </view>
  <view wx:else>
    <view wx:for="{{orders}}" wx:key="orderNo" class="card order-card" hover-class="order-card-hover" data-order-no="{{item.orderNo}}" bindtap="onOpenOrder">
      <view class="row-between order-card-head">
        <text class="order-number">订单 {{item.orderNo}}</text>
        <text class="status-tag status-{{item.status}}">{{orderStatusLabel[item.status]}}</text>
      </view>
      <view class="order-divider"></view>
      <view class="order-product-summary">
        <image class="order-photo" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="order-product-copy">
          <text class="order-product-name">{{item.itemCount}} 种商品</text>
          <text class="order-store">到店自取 · 鲁能超市李老家分店</text>
          <text class="order-created">{{item.displayCreatedAt}}</text>
        </view>
      </view>
      <view class="row-between order-card-foot">
        <view class="order-card-actions">
          <text class="payment-tag payment-{{item.paymentStatus}}">{{paymentStatusLabel[item.paymentStatus]}}</text>
          <view
            wx:if="{{item.deletable}}"
            class="order-delete {{deletingOrderNo === item.orderNo ? 'is-disabled' : ''}}"
            role="button"
            data-order-no="{{item.orderNo}}"
            catchtap="onDeleteOrder"
          >{{deletingOrderNo === item.orderNo ? '删除中' : '删除'}}</view>
        </view>
        <view><text class="order-total-label">合计</text><text class="price">{{item.displayTotal}}</text><text class="order-arrow">›</text></view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="state-panel">加载中...</view>
    <view wx:elif="{{reachedEnd && orders.length}}" class="state-panel orders-end">已经到底了</view>
  </view>
</view>
