<view class="category-page">
  <view class="category-topbar">
    <view class="category-search" role="button" aria-label="搜索店内商品" hover-class="category-search-hover" bindtap="onOpenSearch">
      <t-icon name="/assets/icons/search.svg" size="36rpx" />
      <text>搜索店内商品</text>
      <view class="category-search-action">搜索</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-y enhanced lower-threshold="120" bindscrolltolower="onReachBottom">
    <view class="category-content">
      <view class="category-section-heading">
        <view>
          <text class="category-section-title">商品分类</text>
          <text class="category-section-copy">快速找到想买的</text>
        </view>
        <text class="category-count">已展示 {{products.length}} 件</text>
      </view>

      <scroll-view class="category-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-strip-inner">
          <view class="category-chip {{selectedCategoryId == null ? 'is-selected' : ''}}" role="button" aria-label="查看全部商品" data-id="all" hover-class="category-chip-hover" bindtap="onSelectCategory">
            <image class="category-chip-image" src="/assets/categories/fruit.jpg" mode="aspectFill" />
            <text class="category-chip-label">全部商品</text>
          </view>
          <view wx:for="{{categoryPresentation}}" wx:key="id" class="category-chip {{selectedCategoryName === item.name ? 'is-selected' : ''}}" role="button" aria-label="查看分类 {{item.name}}" data-name="{{item.name}}" hover-class="category-chip-hover" bindtap="onSelectCategory">
            <image class="category-chip-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <text class="category-chip-label">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="product-heading">
        <text class="category-section-title">热卖商品</text>
        <text class="category-section-copy">{{selectedCategoryName}}</text>
      </view>

      <view wx:if="{{loading && !products.length}}" class="skeleton-stack">
        <t-skeleton row-col="{{[1, 1, 1]}}" loading theme="paragraph" />
      </view>
      <view wx:elif="{{error && !products.length}}" class="state-panel compact-state">
        <image class="state-icon" src="/assets/icons/state-error.svg" mode="aspectFit" />
        <text class="state-title">商品暂时加载失败</text>
        <text class="state-copy">{{error}}</text>
        <button class="button-secondary state-action" bindtap="loadInitial">重新加载</button>
      </view>
      <view wx:elif="{{empty}}" class="state-panel compact-state">
        <image class="state-icon" src="/assets/icons/state-shop.svg" mode="aspectFit" />
        <text class="state-title">这个分类暂时没有商品</text>
        <text class="state-copy">可以看看其他分类</text>
      </view>
      <view wx:else class="category-product-list">
        <view wx:for="{{products}}" wx:key="id" class="category-product" role="button" aria-label="查看商品 {{item.name}}" data-id="{{item.id}}" hover-class="category-product-hover" bindtap="onOpenProduct">
          <image class="category-product-image" src="{{imageFailed ? '/assets/icons/image-placeholder.svg' : (item.coverImageUrl || '/assets/icons/image-placeholder.svg')}}" mode="aspectFill" lazy-load binderror="onImageError" />
          <view class="category-product-copy">
            <text class="category-product-name">{{item.name}}</text>
            <text class="stock-copy">库存充足 · 到店自取</text>
            <view class="category-price-line">
              <view><text class="category-price">{{item.displayPrice}}</text><text class="category-unit">/{{item.unit}}</text></view>
              <view class="quick-add" aria-label="查看并加购"><image class="quick-add-icon" src="/assets/icons/plus.svg" mode="aspectFit" /></view>
            </view>
          </view>
        </view>
        <view wx:if="{{loading}}" class="list-feedback">正在加载更多商品…</view>
        <view wx:elif="{{reachedEnd && products.length}}" class="list-feedback">已展示当前分类全部商品</view>
      </view>
    </view>
  </scroll-view>

  <app-tab-bar value="category" />
</view>
