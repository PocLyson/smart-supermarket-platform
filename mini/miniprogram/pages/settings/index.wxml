<view class="settings-page">
  <view class="settings-content">
    <view class="settings-group">
      <text class="settings-group-title">账号设置</text>
      <view class="settings-row">
        <text class="settings-label">当前账号</text>
        <text class="settings-value">{{accountStatus}}</text>
      </view>
      <view wx:if="{{loggedIn}}" class="settings-row is-action" role="button" hover-class="settings-row-hover" bindtap="onPickupInfo">
        <view class="settings-copy">
          <text class="settings-label">取货信息</text>
          <text class="settings-description">修改取货人姓名和手机号</text>
        </view>
        <image class="settings-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>
      <view wx:if="{{loggedIn}}" class="settings-row is-action local-cleanup-row" role="button" hover-class="settings-row-hover" bindtap="onClearLocalData">
        <view class="settings-copy">
          <text class="settings-label">清除本地使用记录</text>
          <text class="settings-description">购物车、搜索记录和待提交订单</text>
        </view>
        <text class="settings-action-copy">{{clearing ? '清除中…' : '清除'}}</text>
      </view>
      <view wx:if="{{loggedIn}}" class="settings-row is-action" role="button" hover-class="settings-row-hover" bindtap="onLogout">
        <text class="settings-label">退出登录</text>
        <image class="settings-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{loggedIn}}" class="settings-group danger-group">
      <text class="settings-group-title">账号管理</text>
      <view
        class="delete-account-button {{deleting ? 'is-disabled' : ''}}"
        role="button"
        aria-disabled="{{deleting}}"
        hover-class="settings-row-hover"
        bindtap="onDeleteAccount"
      >
        <text class="delete-account-label">{{deleting ? '注销中…' : '注销账号'}}</text>
      </view>
      <text class="danger-description">注销后账号无法恢复，未完成订单需先处理</text>
    </view>

    <view wx:if="{{error}}" class="settings-error" role="alert">{{error}}</view>
  </view>
</view>
