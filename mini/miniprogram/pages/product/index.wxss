.product-page {
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

.product-image {
  width: 100%;
  height: var(--size-product-hero);
  margin-bottom: var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-bg-subtle);
}

.product-stock-row {
  display: flex;
  box-sizing: border-box;
  min-height: 96rpx;
  margin-top: var(--space-3);
  border-top: var(--border-width-default) solid var(--color-divider);
  border-bottom: var(--border-width-default) solid var(--color-divider);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-1) var(--space-2);
}

.product-stock-status {
  display: flex;
  align-items: center;
  color: var(--color-success-text);
  gap: var(--space-1);
}

.stock-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-round);
  background: var(--color-success);
}

.product-store-copy {
  margin-left: auto;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: right;
}

.quantity-row {
  display: flex;
  box-sizing: border-box;
  min-height: 112rpx;
  margin-top: var(--space-4);
  border-top: var(--border-width-default) solid var(--color-divider);
  align-items: center;
  justify-content: space-between;
}

.quantity-label {
  font-size: var(--type-helper-size);
  font-weight: var(--weight-semibold);
}

.quantity-stepper {
  display: flex;
  box-sizing: border-box;
  width: 240rpx;
  min-height: 80rpx;
  overflow: hidden;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-md);
  align-items: center;
  text-align: center;
}

.quantity-button {
  display: flex;
  box-sizing: border-box;
  width: 80rpx;
  min-width: 80rpx;
  min-height: 80rpx;
  flex: 0 0 80rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: #FFFFFF;
  color: var(--primary-600);
  font-size: 32rpx;
  line-height: 1;
  align-items: center;
  justify-content: center;
}

.quantity-button::after {
  border: 0;
}

.quantity-button.is-disabled {
  background: var(--color-bg-subtle);
  color: var(--color-disabled-text);
  opacity: 1;
}

.quantity-value {
  display: flex;
  box-sizing: border-box;
  width: 80rpx;
  min-height: 80rpx;
  flex: 0 0 80rpx;
  border-right: var(--border-width-default) solid var(--color-divider);
  border-left: var(--border-width-default) solid var(--color-divider);
  color: var(--color-text-primary);
  font-size: var(--type-body-size);
  font-weight: var(--weight-semibold);
  align-items: center;
  justify-content: center;
}

.product-info {
  padding: var(--space-5) var(--space-5) 0;
}

.product-badges {
  display: flex;
  margin-bottom: var(--space-3);
  gap: var(--space-2);
}

.product-badge {
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--primary-100);
  color: var(--primary-700);
  font-size: var(--type-caption-size);
  font-weight: var(--weight-medium);
  line-height: var(--type-caption-line);
}

.product-badge.is-gold {
  background: var(--color-accent-gold-bg);
  color: var(--color-accent-gold);
}

.product-badge.is-disabled-badge {
  border: var(--border-width-default) solid var(--color-border-default);
  background: var(--color-disabled-bg);
  color: var(--color-disabled-text);
}

.product-title {
  color: var(--color-text-primary);
  font-size: var(--type-page-title-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-page-title-line);
}

.product-price-line {
  display: flex;
  margin-top: var(--space-2);
  align-items: baseline;
}

.product-description {
  display: flex;
  margin-top: var(--space-4);
  flex-direction: column;
  gap: var(--space-2);
}

.description-label {
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
}

.product-description-copy {
  color: var(--color-text-secondary);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.product-purchase-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
  border-top: var(--border-width-default) solid var(--color-divider);
  background: var(--color-bg-surface);
  gap: var(--space-3);
}

.purchase-button {
  flex: 1;
}

.product-purchase-bar .purchase-secondary {
  max-width: 200rpx;
}

.product-error {
  display: flex;
  min-height: 560rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.product-error-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.64;
}

.product-error-title {
  margin-top: var(--space-3);
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
}

.product-error-copy {
  margin-top: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.product-error-action {
  margin-top: var(--space-4);
}

.skeleton-block {
  border-radius: var(--radius-sm);
  background: linear-gradient(
    90deg,
    var(--color-bg-subtle) 25%,
    #FFFFFF 50%,
    var(--color-bg-subtle) 75%
  );
  background-size: 200% 100%;
  animation: product-shimmer 1.2s ease-in-out infinite;
}

.skeleton-hero {
  height: var(--size-product-hero);
  margin-bottom: var(--space-4);
  border-radius: var(--radius-lg);
}

.skeleton-title {
  width: 72%;
  height: 52rpx;
  margin-bottom: var(--space-4);
}

.skeleton-line {
  height: 32rpx;
  margin-bottom: var(--space-2);
}

.skeleton-line.short {
  width: 58%;
}

@keyframes product-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}
