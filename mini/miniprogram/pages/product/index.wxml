<view class="page-shell">
  <view wx:if="{{loading}}" class="state-panel">加载中...</view>
  <view wx:elif="{{error}}" class="state-panel">{{error}}</view>
  <view wx:elif="{{product}}" class="card">
    <image class="product-image" src="{{product.coverImageUrl}}" mode="aspectFill" />
    <view class="section-title">{{product.name}}</view>
    <view class="price">¥{{product.priceCent / 100}} / {{product.unit}}</view>
    <view class="muted">{{product.description}}</view>
    <view class="row">
      <button class="button-primary" bindtap="onAddToCart">加入购物车</button>
      <button class="button-secondary" bindtap="onOpenCart">查看购物车</button>
    </view>
  </view>
</view>
