.home-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-bg-page);
}

.home-header {
  padding:
    calc(env(safe-area-inset-top) + var(--space-5))
    var(--space-4)
    24rpx;
  background: var(--primary-600);
  color: var(--color-bg-surface);
}

.store-heading {
  display: flex;
  align-items: center;
  min-height: var(--size-touch-min);
  margin-bottom: var(--space-4);
  justify-content: space-between;
}

.store-location {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--space-2);
}

.store-name {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: var(--weight-semibold);
  line-height: var(--type-section-title-line);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pickup-badge {
  flex: none;
  padding: var(--space-1) var(--space-2);
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  border-radius: var(--radius-round);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.search-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 96rpx;
  padding: 4rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-surface);
  gap: 8rpx;
  --td-search-bg-color: var(--color-bg-surface);
  --td-search-height: 88rpx;
  --td-search-square-radius: 20rpx;
  --td-search-padding: 12rpx 20rpx;
  --td-search-icon-size: 34rpx;
  --td-search-font: 28rpx / 40rpx var(--td-font-family, PingFang SC, Microsoft YaHei, Arial Regular);
  --td-search-placeholder-color: #8A96A8;
}

.search-field {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.search-input-wrap {
  min-width: 0;
  flex: 1;
}

.home-search {
  box-sizing: border-box;
  width: 100%;
}

.search-clear {
  display: flex;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
}

.search-clear-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-button {
  box-sizing: border-box;
  width: 164rpx;
  min-width: 164rpx;
  min-height: 88rpx;
  margin: 0 !important;
  padding: 0;
  border-radius: 20rpx;
  flex: 0 0 164rpx;
}

.category-item::after {
  border: 0;
}
.home-content {
  padding: var(--space-4) var(--space-4) calc(196rpx + env(safe-area-inset-bottom));
}

.home-hero {
  position: relative;
  height: 296rpx;
  overflow: hidden;
  margin-bottom: var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--primary-600);
}

.hero-image {
  position: absolute;
  right: 0;
  width: 52%;
  height: 100%;
}

.hero-copy {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  width: 56%;
  padding: var(--space-5) var(--space-4);
  flex-direction: column;
  color: var(--color-bg-surface);
}

.hero-kicker {
  box-sizing: border-box;
  align-self: flex-start;
  max-width: 100%;
  padding: 8rpx 20rpx;
  white-space: nowrap;
  margin-bottom: 24rpx;
  border-radius: var(--radius-round);
  background: rgba(255, 255, 255, 0.16);
  font-size: 20rpx;
  line-height: 32rpx;
}

.hero-title {
  white-space: pre-line;
  font-size: 42rpx;
  font-weight: var(--weight-bold);
  line-height: var(--type-section-title-line);
}

.hero-subtitle {
  margin-top: var(--space-3);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.category-heading {
  display: flex;
  margin-bottom: var(--space-3);
  align-items: baseline;
  justify-content: space-between;
}

.category-title {
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-section-title-line);
}

.category-tip {
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.category-grid {
  display: flex;
  margin-bottom: var(--space-6);
  flex-wrap: nowrap;
  gap: var(--space-2);
}

.category-slot {
  box-sizing: border-box;
  width: calc((100% - 64rpx) / 5);
}

.category-item {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 144rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--color-text-primary);
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.category-image-wrap {
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  margin-bottom: var(--space-1);
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: 20rpx;
  background: var(--primary-50);
}

.category-image {
  width: 100%;
  height: 100%;
}

.category-name {
  display: block;
  max-width: 128rpx;
  overflow: hidden;
  font-size: var(--type-caption-size);
  font-weight: var(--weight-medium);
  line-height: var(--type-caption-line);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item.is-selected .category-image-wrap {
  border-color: var(--primary-600);
  box-shadow: 0 0 0 4rpx var(--primary-100);
}

.category-item.is-selected .category-name {
  color: var(--primary-700);
}

.category-hover {
  background: var(--primary-100);
}

.recommend-section {
  margin-top: var(--space-2);
}

.section-heading {
  display: flex;
  align-items: baseline;
  margin-bottom: var(--space-3);
  gap: var(--space-3);
}

.section-title {
  margin: 0;
  font-size: var(--type-section-title-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-section-title-line);
}

.section-subtitle {
  color: var(--primary-600);
  font-size: var(--type-helper-size);
  line-height: var(--type-helper-line);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.product-card {
  overflow: hidden;
  border: var(--border-width-default) solid var(--color-divider);
  border-radius: var(--radius-md);
  background: var(--color-bg-surface);
  box-shadow: var(--shadow-card);
}

.product-card-hover {
  border-color: var(--primary-300);
  background: var(--primary-50);
}

.product-image {
  display: block;
  width: 100%;
  height: 272rpx;
  background: var(--color-bg-subtle);
}

.product-content {
  padding: var(--space-3);
}

.product-name {
  display: -webkit-box;
  min-height: var(--type-card-title-line);
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--type-card-title-size);
  font-weight: var(--weight-semibold);
  line-height: var(--type-card-title-line);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.deal-tag {
  display: inline-flex;
  margin-top: var(--space-2);
  padding: 2rpx var(--space-1);
  border-radius: var(--radius-xs);
  background: var(--color-success-bg);
  color: var(--color-success-text);
  font-size: 22rpx;
  font-weight: var(--weight-medium);
  line-height: 32rpx;
}

.product-meta {
  display: flex;
  align-items: baseline;
  margin-top: var(--space-2);
  justify-content: space-between;
}

.product-action {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-round);
  border: 3rpx solid var(--primary-600);
  background: #FFFFFF;
  align-items: center;
  justify-content: center;
}

.product-action-icon {
  width: 34rpx;
  height: 34rpx;
}

.product-price {
  color: var(--color-price);
  font-size: var(--type-money-size);
  font-weight: var(--weight-bold);
  line-height: var(--type-money-line);
}

.product-unit {
  margin-left: var(--space-1);
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.home-state {
  display: flex;
  margin-top: var(--space-4);
  flex-direction: column;
  align-items: center;
}

.home-state-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.62;
}

.home-state-title {
  margin-top: var(--space-2);
  color: var(--color-text-primary);
  font-weight: var(--weight-semibold);
}

.home-state-copy {
  margin: var(--space-1) 0 var(--space-3);
  color: var(--color-text-tertiary);
  font-size: var(--type-helper-size);
}

.list-end {
  padding: var(--space-6) 0 var(--space-3);
  color: var(--color-text-tertiary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
  text-align: center;
}

.skeleton-card {
  pointer-events: none;
}

.skeleton-block {
  border-radius: var(--radius-sm);
  background: linear-gradient(
    90deg,
    var(--color-bg-subtle) 25%,
    #FFFFFF 50%,
    var(--color-bg-subtle) 75%
  );
  background-size: 200% 100%;
  animation: home-shimmer 1.2s ease-in-out infinite;
}

.skeleton-image {
  height: 272rpx;
  border-radius: 0;
}

.skeleton-line {
  height: 32rpx;
  margin-bottom: var(--space-2);
}

.skeleton-line.short {
  width: 68%;
}

.skeleton-price {
  width: 48%;
  height: 40rpx;
  margin-top: var(--space-4);
}

@keyframes home-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}
