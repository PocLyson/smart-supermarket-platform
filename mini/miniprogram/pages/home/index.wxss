.category-strip {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: var(--space-3);
  white-space: nowrap;
}

.category-button {
  display: inline-block;
  margin-right: var(--space-2);
}

.product-card {
  display: flex;
  gap: var(--space-3);
}

.product-image {
  width: var(--size-product-thumb);
  height: var(--size-product-thumb);
  flex: 0 0 auto;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
}

.product-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}
