<view class="home-page">
  <view class="home-header">
    <view class="store-heading" aria-label="当前门店 鲁能超市李老家分店">
      <view class="store-location">
        <t-icon name="/assets/icons/location.svg" size="44rpx" />
        <text class="store-name">鲁能超市李老家分店</text>
      </view>
      <text class="pickup-badge">到店自取</text>
    </view>

    <view class="search-card">
      <view class="search-field">
        <view class="search-input-wrap">
          <t-search
            t-class="home-search"
            value="{{keyword}}"
            left-icon="/assets/icons/search.svg"
            clearable="{{false}}"
            placeholder="搜索店内商品"
            bind:change="onKeywordInput"
            bind:submit="onSearch"
          />
        </view>
        <view wx:if="{{keyword}}" class="search-clear" role="button" aria-label="清空搜索内容" bindtap="onClearSearch">
          <image class="search-clear-icon" src="/assets/icons/close-circle.svg" mode="aspectFit" />
        </view>
      </view>
      <t-button t-class="search-button" theme="primary" size="medium" bind:tap="onSearch">搜索</t-button>
    </view>
  </view>

  <view class="home-content">
    <view class="home-hero">
      <image class="hero-image" src="/assets/home/navy-fresh-grocery-hero.jpg" mode="aspectFill" />
      <view class="hero-copy">
        <text class="hero-kicker">今日精选</text>
        <text class="hero-title">新鲜好物
到店即取</text>
        <text class="hero-subtitle">门店现货 · 省时省心</text>
      </view>
    </view>

    <view class="category-heading">
      <text class="category-title">热门分类</text>
      <text class="category-tip">全部 ›</text>
    </view>

    <view id="category-section" class="category-grid">
      <view wx:for="{{categoryPresentation}}" wx:key="id" class="category-slot">
        <view class="category-item" role="button" aria-label="{{item.name}}" data-name="{{item.name}}" hover-class="category-hover" bindtap="onSelectCategory">
          <view class="category-image-wrap"><image class="category-image" src="{{item.imageUrl}}" mode="aspectFill" /></view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{error && !products.length}}" class="state-panel home-state">
      <image class="home-state-icon" src="/assets/icons/close-circle.svg" mode="aspectFit" />
      <text class="home-state-title">商品暂时加载失败</text>
      <text class="home-state-copy">{{error}}</text>
      <t-button theme="primary" variant="outline" size="small" bind:tap="loadInitial">重试</t-button>
    </view>
    <view wx:elif="{{empty}}" class="state-panel home-state">
      <image class="home-state-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <text class="home-state-title">暂时没有在售商品</text>
      <text class="home-state-copy">可以稍后再来看看</text>
    </view>

    <view wx:elif="{{loading && !products.length}}" class="recommend-section">
      <view class="section-heading">
        <text class="section-title">精选商品</text>
        <text class="section-subtitle">正在准备商品</text>
      </view>
      <view class="product-grid">
        <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="product-card skeleton-card" aria-hidden="true">
          <view class="skeleton-block skeleton-image"></view>
          <view class="product-content">
            <view class="skeleton-block skeleton-line"></view>
            <view class="skeleton-block skeleton-line short"></view>
            <view class="skeleton-block skeleton-price"></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="recommend-section">
      <view class="section-heading">
        <text class="section-title">精选商品</text>
        <text class="section-subtitle">门店现货 · 到店自取</text>
      </view>
      <view class="product-grid">
        <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" hover-class="product-card-hover" bindtap="onOpenProduct">
          <image class="product-image" src="{{imageFailed ? '/assets/icons/image-placeholder.svg' : (item.coverImageUrl || '/assets/icons/image-placeholder.svg')}}" mode="aspectFill" binderror="onImageError" />
          <view class="product-content">
            <text class="product-name">{{item.name}}</text>
            <text class="deal-tag">门店精选</text>
            <view class="product-meta">
              <view>
                <text class="product-price">{{item.displayPrice}}</text>
                <text class="product-unit">/{{item.unit}}</text>
              </view>
              <view class="product-action" aria-label="查看商品"><image class="product-action-icon" src="/assets/icons/plus.svg" mode="aspectFit" /></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{loading}}" class="state-panel home-state">加载中...</view>
      <view wx:elif="{{reachedEnd && products.length}}" class="list-end">已经到底了</view>
    </view>
  </view>

  <app-tab-bar value="home" />
</view>
